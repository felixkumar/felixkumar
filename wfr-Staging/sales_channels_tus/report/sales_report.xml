<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_product_search_sale_inherit" model="ir.ui.view">
        <field name="name">sale.report.search</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='User']" position="after">
                <filter string="Sales Channel" name="sales_channel_id" context="{'group_by':'sales_channel_id'}"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sales_channel_id"/>
            </xpath>
        </field>
    </record>
</odoo>