<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_multi_company_inventory_transfer_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.multi.company.inventory.transfer.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='warehouse_setting_container']" position="after">
                    <h2>Multi-Company Inventory Transfer</h2>
                    <div class="row mt16 o_settings_container" name="multi_company_inventory_transfer">
                        <div class="col-12 col-lg-6 o_setting_box" id="is_multi_company_inventory_transfer">
                            <div class="o_setting_left_pane">
                                <field name="is_multi_company_inventory_transfer"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="is_multi_company_inventory_transfer" string="Multi-Company Inventory Transfer"/>
                                <div class="text-muted">Managing the transfer from one company to another.</div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>