<odoo>
    <record id="account_asset_report_wizard_view" model="ir.ui.view">
        <field name="name">account.asset.report.wizard.view</field>
        <field name="model">account.assets.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="company_id" options="{'no_create': True,'no_edit': True}"/>
                        <field name="assets_category_ids" widget="many2many_tags"
                               options="{'no_create': True,'no_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Excel Report" type="object" class="btn btn-primary"
                            name="generate_xlsx_report"/>
                    <button string="cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="account_asset_report_wizard_view_action" model="ir.actions.act_window">
        <field name="name">Assets Report</field>
        <field name="res_model">account.assets.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

<!--    <menuitem id="account_asset_report_wizard_view_action_menu" name="Asset Report"-->
<!--              action="account_asset_report_wizard_view_action"-->
<!--              parent="account.menu_finance_reports"/>-->

</odoo>