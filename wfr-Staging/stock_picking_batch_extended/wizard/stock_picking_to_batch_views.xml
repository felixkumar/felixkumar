<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- add picking to batch  -->
    <record id="stock_picking_to_batch_form_extended_three_step_batch" model="ir.ui.view">
        <field name="name">stock.picking.to.batch.form.extended.three.step.batch</field>
        <field name="model">stock.picking.to.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_to_batch_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='is_create_draft']" position="before">
                    <field name="batch_group_id"
                           attrs="{'invisible': [('mode', '!=', 'existing_group')], 'required': [('mode', '=', 'existing_group')]}"/>
                </xpath>
                <xpath expr="//field[@name='is_create_draft']" position="after">
                    <field name="validate_and_create_all_batch" string="Process Pick, Pack and Ship In Group?"/>
                </xpath>
                <xpath expr="//field[@name='batch_id']" position="replace">
                    <field name="batch_id" options="{'no_create': True, 'no_open': True}"
                           attrs="{'invisible': [('mode', '!=', 'existing')], 'required': [('mode', '=', 'existing')]}"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="replace">
                    <field name="user_id" options="{'no_create': True, 'no_open': True}"
                           attrs="{'invisible': [('mode', '!=', 'new')]}"/>
                </xpath>
                <xpath expr="//field[@name='is_create_draft']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </data>
        </field>
    </record>

