<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_validate_batch_transfer" model="ir.cron">
            <field name="name">Batch: Auto Validate Transfers</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="doall">1</field>
            <field name="model_id" ref="model_stock_picking_batch"/>
            <field name="code">model.auto_validate_batch_transfer()</field>
        </record>

        <record id="ir_cron_create_batch_group" model="ir.cron">
            <field name="name">Batch: Create Batch Group</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">8</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="doall">1</field>
            <field name="model_id" ref="model_stock_picking_batch_group"/>
            <field name="code">model.auto_create_batch_group()</field>
        </record>

        <record id="seq_picking_batch_group" model="ir.sequence">
            <field name="name">Batch Transfer Group</field>
            <field name="code">picking.batch.group</field>
            <field name="prefix">BATCH-%(year)s-%(month)s-%(day)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
