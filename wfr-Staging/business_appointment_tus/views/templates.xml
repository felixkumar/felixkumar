    <template id="portal_appointment_page_tus" inherit_id="business_appointment_website.portal_appointment_page" name="My Appointment">
        <xpath expr="//div[@id='business-appointments-portal-buttons']/a[hasclass('business-appoinment-portal-repeat')]" position="replace">
            <a role="button"
               t-att-id="ba_appointment_id.id"
