                                <div class="o_setting_left_pane">
                                    <field name="auto_import_walmart_wfs_inventory" widget="boolean_toggle"
                                           class="o_onboard_boolean_toggle" style="margin-left: -0.5em"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <span>
                                        <h6>Import Walmart WFS Inventory ?</h6>
                                    </span>
                                    <div class="text-muted">
                                        Import Walmart WFS Inventory
                                    </div>
                                    <br/>

                                    <div class="o_onboard_cron_settings"
                                         attrs="{'invisible': [('auto_import_walmart_wfs_inventory', '=', False)]}">
