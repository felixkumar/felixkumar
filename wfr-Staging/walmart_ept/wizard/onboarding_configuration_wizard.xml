                                               attrs="{'required': [('auto_import_walmart_wfs_inventory', '=', True)]}"
                                               class="o_onboard_cron_user"/>
                                    </div>
                                </div>
                            </div>
                    </div>
                </div>
                <footer>
                    <button string="Save" class="oe_highlight o_onboard_button" type="object"
                            name="save_cron_configuration"
                            invisible="context.get('is_calling_from_onboarding_panel', False) and not context.get('is_instance_exists', False)"
                            attrs="{'invisible': [('walmart_marketplace_id', '=', False)]}"/>
                    <button string="Cancel" special="cancel"
                            class="oe_highlight o_onboard_button_white"/>
                </footer>
                <script>
                    $('document').ready(function(){
                    $('div.o_form_view.o_walmart_ept').parents('div.modal-content').addClass('on_board_custom_form');
                    });
                </script>
            </form>
        </field>
    </record>

