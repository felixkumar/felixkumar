                                               attrs="{'required': [('auto_import_walmart_wfs_inventory', '=', True)]}"
                                               class="o_onboard_cron_box"/>
                                        <field name="auto_import_walmart_wfs_inventory_interval_type"
                                               placeholder="Interval Type"
                                               attrs="{'required': [('auto_import_walmart_wfs_inventory', '=', True)]}"
                                               class="o_onboard_cron_type"/>
                                        <field name="auto_import_walmart_wfs_inventory_next_execution"
