<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard view to create Walmart Marketplace -->
    <record id="create_walmart_instace_form_view_ept" model="ir.ui.view">
        <field name="name">create.walmart.instance.view.form.ept</field>
        <field name="model">walmart.instance.create.ept</field>
        <field name="arch" type="xml">
            <form string="Create Walmart Marketplace Instance" class="oe_form_configuration">
                <group>
                    <group>
                        <field name="name" required="1"/>
                        <field name='walmart_consumer_id' required="1" string="Client Id"/>
                        <field name='is_selling_on_wfs' required="0" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <field name='walmart_country_id' required="1"/>
                        <field name="environment" required="1"/>
                        <field name='walmart_channel_type' invisible="1" required="1"/>
                    </group>
                </group>
<!--                <group>-->
<!--                    <group>-->
<!--                        <field name="update_notification" widget="boolean_toggle"/>-->
<!--                    </group>-->
<!--                    <group>-->
<!--                        <field name="customer_so_number"/>-->
<!--                    </group>-->
<!--                </group>-->

                <group string="Client Secret" colspan="2">
                    <field name="walmart_secret_key" nolabel="1" required="1" colspan="2"/>
                </group>
                <group invisible="context.get('is_calling_from_onboarding_panel', False)">
                    <p colspan="2" class="alert alert-warning" role="alert">
                        <div style="color:#ff0000; font-size:15px;">
                            <b>Important Note:</b>
                        </div>
                        <div class="d-inline-block w-100">
                            <div class="row">
                                <div class="col-11 p-0">
                                    <ul>
                                        <li>
                                            If you choose to activate <b>Get Update Notification</b>, Emipro Server will
                                            ask for details about your Odoo, including Company name, Company email,
                                            Database UUID, and List of Emipro apps. Therefore, Emipro can inform you of
                                            any app-related updates and fixes. You can disable this configuration at any
                                            time.
                                            Please check our privacy policy for more detail.
                                            <a href='https://www.emiprotechnologies.com/iap-privacy-policy'
                                               target="_blank">
                                                Click Here
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </p>
                </group>
                <footer>
                    <button string="Create" type="object" name="test_walmart_connection"
                            class="oe_highlight"/>
                    <span style="padding: 0.5rem 0.3rem;"> or </span>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Create Walmart Marketplace -->
    <record id="create_walmart_instace_action_ept" model="ir.actions.act_window">
        <field name="name">Walmart Marketplace</field>
        <field name="res_model">walmart.instance.create.ept</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="create_walmart_instace_form_view_ept"/>
    </record>
</odoo>
		