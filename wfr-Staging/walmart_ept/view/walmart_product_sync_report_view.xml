<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view of Walmart Product Sync Reports -->
    <record id="walmart_product_sync_report_tree_view_ept" model="ir.ui.view">
        <field name="name">Product Sync Reports</field>
        <field name="model">walmart.product.sync.report.ept</field>
        <field name="arch" type="xml">
            <tree string="Walmart Product Sync" create="0">
                <field name="name"/>
                <field name="user_id"/>
                <field name="requested_date"/>
                <field name="walmart_instance_id" optional="show"/>
                <field name="attachment_id" optional="hide"/>
                <field name="auto_create_product" optional="hide"/>
                <field name="import_stock" optional="hide"/>
                <field name="log_book_id" optional="hide"/>
                <field name="update_price_in_pricelist" optional="hide"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <!-- Form view of Walmart Product Sync -->
    <record id="walmart_product_sync_form_view_ept" model="ir.ui.view">
        <field name="name">Product Sync</field>
        <field name="model">walmart.product.sync.report.ept</field>
        <field name="arch" type="xml">
            <form string="Walmart Product Sync" create="0">
                <header>
<!--                    <button name="walmart_get_product_report" string="Get Report"-->
<!--                            attrs="{'invisible':[('state','in',['downloaded', 'processed'])]}"-->
<!--                            class="oe_highlight"-->
<!--                            type="object"/>-->
                    <button name="create_report_request" string="Send Request"
                            attrs="{'invisible':[('state','!=','draft')]}"
                            class="oe_highlight"
                            type="object"/>
                    <button name="report_request_status" string="Check Status"
                            attrs="{'invisible':[('state','!=','request_sent')]}"
                            class="oe_highlight"
                            type="object"/>
                    <button name="walmart_product_process_report" string="Process"
                            attrs="{'invisible':[('state','in',['draft', 'request_sent', 'processed'])]}"
                            class="oe_highlight"
                            type="object"/>
                    <!-- TODO: don't know why this button is here -->
<!--                    <button name="walmart_mismatch_details" string="Mismatch details"-->
<!--                            attrs="{'invisible':[('state','in',['draft'])]}" class="oe_highlight"-->
<!--                            type="object"/>-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div style="display: flex; justify-content: flex-end">
                        <field name="request_status" readonly="1" widget="badge"
                           class="badge badge-pill" style="float: right;" nolabel="1"
                           decoration-success="request_status == 'READY'"
                           decoration-info="request_status == 'INPROGRESS'"
                           decoration-warning="request_status == 'RECEIVED'"
                           decoration-danger="request_status == 'ERROR'"
                           attrs="{'invisible':[('request_status', '=', False)]}"/>
                    </div>
                    <group name="product_sync">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="walmart_instance_id" widget="selection" readonly="1"/>
                            <field name="report_request_id" readonly="1"/>
                            <field name="log_book_id" invisible="1"/>
                            <field name="auto_create_product"/>
                            <field name="update_price_in_pricelist"/>
                            <field name="skip_existing_product"
                                   string="Do Not Update Existing Products"/>
                        </group>
                        <group>
                            <field name="requested_date" readonly="1"/>
                            <field name="user_id" widget="selection" readonly="1"/>
                            <field name="is_product_image" string="Update Product Image?"/>
                            <field name="import_stock"/>
                            <field name="is_validate_inventory" string="Validate Inventory?"
                                   attrs="{'invisible': [('import_stock', '=', False)]}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View For Walmart Product Sync -->
    <record id="walmart_product_sync_search_view_ept" model="ir.ui.view">
        <field name="name">view.walmart.product.sync.filter</field>
        <field name="model">walmart.product.sync.report.ept</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search Walmart Product">
                <field name="name"/>
            </search>
        </field>
    </record>


    <!-- Tree view action of Walmart Marketplace Offers -->
    <record id="action_walmart_product_sync_tree_ept" model="ir.actions.act_window">
        <field name="name">Product Sync</field>
        <field name="res_model">walmart.product.sync.report.ept</field>
        <field name="view_id" ref="walmart_product_sync_report_tree_view_ept"/>
    </record>

    <!-- Sub Menu Offers of Walmart Product Sync Menu -->
    <menuitem id="sub_menu_walmart_offer_reports" name="Offer Report"
              parent="walmart_ept.main_menu_walmart_offers"
              sequence="2" groups="walmart_ept.group_walmart_user"
              action="action_walmart_product_sync_tree_ept"/>

</odoo>