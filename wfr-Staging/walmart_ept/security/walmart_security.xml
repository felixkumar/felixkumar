<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_walmart_ept">
            <field name="name">Walmart</field>
            <field name="description">Helps you handle your Walmart accounts</field>
            <field name="sequence">59</field>
        </record>

        <record model="res.groups" id="group_walmart_user">
            <field name="name">Walmart User</field>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
            <field name="category_id" ref="walmart_ept.module_walmart_ept"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record model="res.groups" id="group_walmart_manager">
            <field name="name">Walmart Manager</field>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
            <field name="category_id" ref="walmart_ept.module_walmart_ept"/>
            <field name="implied_ids" eval="[(4,ref('group_walmart_user'))]"/>
        </record>


        <!-- Multi - Company Rules -->
        <record model="ir.rule" id="walmart_instance_comp_rule">
            <field name="name">Walmart Instance multi-company</field>
            <field name="model_id" ref="model_walmart_marketplace_ept"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',user.company_ids and user.company_ids.ids or [user.company_id.id])]</field>
        </record>
    </data>
</odoo>