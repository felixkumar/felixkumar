<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!--Inherit search view-->
    <record id="walmart_view_order_product_search" model="ir.ui.view">
        <field name="name">walmart.sale.report.search</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="walmart_marketplace" string="Walmart Marketplace"
                        domain="[('walmart_marketplace_id','!=',False)]"/>
                <field name="walmart_marketplace_id" invisible='1'/>
                <filter string="Walmart Marketplace" name="groupby_walmart_marketplace_id"
                        context="{'group_by':'walmart_marketplace_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- This action is used while odoo is enterprise-->
    <record id="walmart_sale_report_action_dashboard" model="ir.actions.act_window">
        <field name="name">Walmart Sales Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">dashboard,pivot,graph</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="context" eval="{
                    'search_default_Sales': 1,
                    'search_default_filter_date': 1,
                    'search_default_walmart_marketplace': 1}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p>
            <p>
                Create a new sales order.
            </p>
        </field>
    </record>

    <!-- This action is used while odoo is community-->
    <record id="walmart_action_order_report_all" model="ir.actions.act_window">
        <field name="name">Walmart Sales Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_id"/>  <!-- force empty -->
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="context">{'search_default_Sales': 1,
                               'search_default_groupby_walmart_marketplace_id':
                                   1, 'group_by_no_leaf': 1, 'group_by': []}
        </field>
        <field name="help">This report performs analysis on your quotations and sales orders.
            Analysis check your sales revenues and sort it by different group criteria (salesman,
            partner, product, etc.) Use this report to perform analysis on sales not having invoiced
            yet. If you want to analyse your turnover, you should use the Invoice Analysis report in
            the Accounting application.
        </field>
    </record>

    <!--It is used to redirect action base on odoo version(community/enterprise)-->
    <record id="action_order_report_all" model="ir.actions.server">
        <field name="name">Walmart Sale Report</field>
        <field name="model_id" ref="model_sale_report"/>
        <field name="state">code</field>
        <field name="code">action = env.get('sale.report').walmart_sale_report()</field>
    </record>
    <!-- Menu Section -->
    <menuitem id="menu_item_parent_walmart_reporting_ept" name="Reporting"
              parent="walmart_ept.walmart_main_menu" sequence="18"
              groups="walmart_ept.group_walmart_manager"/>

    <menuitem action="action_order_report_all" name="Sales Analysis"
              id="menu_report_product_all"
              parent="walmart_ept.menu_item_parent_walmart_reporting_ept"
              sequence="10"/>

</odoo>
