<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_update_order_status" model="ir.cron">
        <field name="name">Update Order Status</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="model_id" eval="ref('walmart_ept.model_walmart_marketplace_ept')"/>
        <field name="state">code</field>
        <field name="code">model.auto_update_order_status_ept(args={})</field>
    </record>

