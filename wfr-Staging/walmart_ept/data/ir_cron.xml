    <!--Auto cron job for process order data queue and it runs every 5 min.-->
    <record id="process_walmart_order_queue" model="ir.cron">
        <field name="name">Walmart: Process Orders Queue</field>
        <field eval="False" name="active"/>
        <field name="model_id" ref="model_walmart_order_queue_line_ept"/>
        <field name="state">code</field>
        <field name="code">model.auto_import_order_queue_data()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

