<?xml version="1.0"?>
<odoo>
    <record id="product_template_view_form_normal_inherit_tus_account" model="ir.ui.view">
        <field name="name">product.template.view.form.normal.inherit.tus.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='asset_category_id']" position="after">
                <field name="is_add_analytic_account"/>
            </xpath>
        </field>
    </record>
</odoo>
