<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="form_view_account_quickbook_type" model="ir.ui.view">
            <field name="name">account.quickbooks.type.form.view</field>
            <field name="model">account.quickbooks.type</field>
            <field name="arch" type="xml">
                <form string="Account Quickbook Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Type Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="account_type" required="1"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tree_view_account_quickbook_type" model="ir.ui.view">
            <field name="name">account.quickbooks.type.tree.view</field>
            <field name="model">account.quickbooks.type</field>
            <field name="arch" type="xml">
                <tree string="Account Quickbook View">
                    <field name="name"/>
                    <field name="account_type"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="action_account_quickbook_type" model="ir.actions.act_window">
            <field name="name">Account Detail Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.quickbooks.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

        <menuitem id="account_detail_type_menu"
                  action="warefor_account.action_account_quickbook_type"
                  sequence="31"
                  name="Account Detail Type"
                  parent="account.account_account_menu"
        />

    </data>
</odoo>