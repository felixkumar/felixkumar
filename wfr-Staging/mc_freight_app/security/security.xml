<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_freight">
            <field name="name">Freight App</field>
            <field name="sequence">50</field>
        </record>
        <record model="res.groups" id="group_freight_user">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_freight"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record model="res.groups" id="group_freight_administrator">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_freight"/>
            <field name="implied_ids" eval="[Command.clear(),Command.link(ref('mc_freight_app.group_freight_user'))]"/>
            <field name="users" eval="[Command.link(ref('base.user_root'))]"/>
        </record>
    </data>
</odoo>
