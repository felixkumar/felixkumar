        <!-- Form View -->


        <record id="freight_freights_action_form_view" model="ir.ui.view">
            <field name="name">freight.freights.action.form.view</field>
            <field name="model">freight.freight</field>
            <field name="arch" type="xml">
                <form string="Project Logistics" delete="false">
                    <header>
                        <field name="is_outbound" invisible="1"/>
                        <field name="delivery_status" widget="statusbar" invisible="1"
                               options="{'clickable': '1'}"
                        />
                        <field name="stage_id" widget="statusbar"
                               options="{'clickable': '1', 'fold_field': 'is_fold'}"
                               attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                        <field name="outbound_stage_id" widget="statusbar"
                               options="{'clickable': '1', 'fold_field': 'is_fold'}"
                               attrs="{'invisible': [('is_outbound', '!=', True)]}"
                        />
                    </header>
                    <sheet>
                        <group>
                            <div class="oe_title">
                                <h1>
                                    <field name="name" nolabel="1" placeholder="e.g. SHIP00001"/>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <group string="General">
                                <field name="import_id" attrs="{'invisible': [('is_outbound', '=', True)]}"
                                       widget="many2many_tags"/>
                                <field name="partner_id" string="Customer" widget="many2many_tags"
                                       attrs="{'invisible': [('is_outbound', '!=', True)]}"/>
                                <field name="partner_id" string="Customer / Consignee" widget="many2many_tags"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                <field name="outbound_partner_id" attrs="{'invisible': [('is_outbound', '!=', True)]}"
                                       domain="[('is_3pl_customer','=',True)]" context="{'is_outbound': True}"/>
                                <field name="description"/>
                                <field name="consignee_id" required="1"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                <field name="warehouse_id"/>
                                <field name="user_id" domain="[('share','=',False)]"
                                       options="{'no_create_edit': True,'no_create': True}"/>
                            </group>
                            <group attrs="{'invisible': [('is_outbound', '=', True)]}">
                                <div>
                                    <group string="Ocean Freight Dates">
                                        <field name="stuffing_date"
                                               attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                        <!--<field name="date_shipping" attrs="{'invisible': [('is_outbound', '=', True)]}"/>-->
                                        <field name="date_shipping"
                                               attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                        <field name="estimated_arrival_date"
                                               attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                        <field name="date_landing" attrs="{'invisible': [('is_outbound', '=', True)]}"/>

                                    </group>
                                    <group string="Drayage Info">
                                        <field name="freight_transport_id"
                                               attrs="{'invisible': [('is_outbound', '=', True)]}" invisible="1"/>
                                        <!--                                <field name="land_shipping" attrs="{'invisible': [('is_outbound', '=', True)]}"/>-->
                                        <field name="date_order" attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                    </group>
                                </div>
                            </group>
                            <group string="Carrier Information" name="carrier_information"
                                   attrs="{'invisible': [('is_outbound', '!=', True)]}">
                                <field name="bol_number"/>
                            </group>
                        </group>
                        <group>
                            <group string="Bill of Lading Info" attrs="{'invisible': [('is_outbound', '=', True)]}">
                                <field name="forwarder_id" domain="[('is_3pl_customer','=',True)]"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}"
                                       context="{'is_outbound': True}"/>
                                <field name="voyage_no"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                <field name="port_shipping_id" attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                <field name="port_discharge_id" attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                            </group>
                            <group string="Container / Load Info"
                                   attrs="{'invisible': [('is_outbound', '=', True)]}">
                                <field name="vessel" attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                <field name="weight" string="Weight (Lbs)" readonly="True"/>
                                <field name="weight_kg"/>
                                <field name="volume_cuft"/>
                                <field name="volume_cbm"/>
                                <field name="ibl_remarks" placeholder="Remarks"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}" options='{"no_open":True}'/>

                                <!--                                <field name="operation_payment"/>-->
                                <field name="initial_freight_charge"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}" invisible="1"/>
                                <field name="final_freight_charge" attrs="{'invisible': [('is_outbound', '=', True)]}"
                                       invisible="1"/>
                                <field name="freight_invoice" attrs="{'invisible': [('is_outbound', '=', True)]}"
                                       invisible="1"/>
                                <!--                                <field name="commercial_invoice" filename="commercial_invoice_file"/>-->
                                <!--                                <field name="commercial_invoice_file" invisible="1"/>-->
                                <!--                                <field name="commercial_packing_list" filename="commercial_packing_list_file"/>-->
                                <!--                                <field name="commercial_packing_list_file" invisible="1"/>-->
                            </group>
                        </group>
                        <group attrs="{'invisible': [('is_outbound', '=', True)]}">
                            <group string="Customs">
                                <field name="agent_id" domain="[('is_3pl_customer','=',True)]"
                                       attrs="{'invisible': [('is_outbound', '=', True)]}"
                                       context="{'is_outbound': True}"/>
                            </group>
                            <group string="Metrics" name="metrics" attrs="{'invisible': [('is_outbound', '=', True)]}">
                                <field name="price_per_pound"/>
                                <field name="price_per_kg"/>
                                <field name="cost_per_cuft"/>
                                <field name="cost_per_cbm"/>
                            </group>
                        </group>


                        <notebook>
                            <page string="Order" name="order">
                                <group>
                                    <field name="purchase_orders_ids"
                                           attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                    <!--                                    <field name="product_id" widget="many2many_tags"/>-->
                                    <field name="cost" attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                    <button name="create_po_lines" type="object" string="Create Lines"
                                            class="oe_highlight" attrs="{'invisible': [('is_outbound', '=', True)]}"/>
                                </group>
                                <field name="freight_order_line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="goods"/>
                                        <field name="net_weight"/>
                                        <!--                                        <field name="total_kg" string="Net Weight (Kg)" sum="Gross Weight"/>-->
                                        <field name="box_quantity" invisible="1"/>
                                        <field name="num_box" invisible="1"/>
                                        <field name="total_quantity"/>
                                        <field name="base_cost"
                                               attrs="{'column_invisible': [('parent.is_outbound', '=', True)]}"/>
                                        <field name="value" sum="Total Value"
                                               attrs="{'column_invisible': [('parent.is_outbound', '=', True)]}"/>
                                        <field name="base_sale_price" invisible="1"/>
                                        <field name="sale_price" sum="Total Sale Price"
                                               attrs="{'column_invisible': [('parent.is_outbound', '=', True)]}"/>
                                        <!--                                        <field name="net_weight"/>-->
                                    </tree>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="goods"/>
                                                <field name="box_quantity"/>
                                                <field name="value"/>
                                                <field name="container_id"/>
                                                <field name="total_kg" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="gross_weight" string="Part Weight" sum="Gross Weight"/>
                                                <field name="num_box"/>
                                                <field name="sale_price"/>
                                                <field name="total_quantity"/>
                                                <field name="net_weight"/>
                                                <!--                                                <field name="freight_id"/>-->
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <!--                            <page string="Routes">-->
                            <!--                                <field name="freight_routes_ids">-->
                            <!--                                    <tree editable="bottom">-->
                            <!--                                        <field name="route_operation"/>-->
                            <!--                                        <field name="source_location"/>-->
                            <!--                                        <field name="destination_location"/>-->
                            <!--                                        <field name="transportation"/>-->
                            <!--                                        <field name="cost"/>-->
                            <!--                                        <field name="sale"/>-->
                            <!--                                    </tree>-->
                            <!--                                </field>-->
                            <!--                            </page>-->
                            <!--                            <page string="Information">-->
                            <!--                                <label for="other_info"/>-->
                            <!--                                <field name="other_info"/>-->
                            <!--                            </page>-->
                            <!--                            <page string="Tracking">-->
                            <!--                                <field name="freight_tracking_ids">-->
                            <!--                                    <tree editable="bottom">-->
                            <!--                                        <field name="location_id"/>-->
                            <!--                                        <field name="description"/>-->
                            <!--                                        <field name="Date"/>-->
                            <!--                                    </tree>-->
                            <!--                                </field>-->
                            <!--&lt;!&ndash;                                <group>&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    <field name="document_upload" filename="document_file"/>&ndash;&gt;-->
                            <!--&lt;!&ndash;                                    <field name="document_file" invisible="1"/>&ndash;&gt;-->
                            <!--&lt;!&ndash;                                </group>&ndash;&gt;-->
                            <!--                            </page>-->
                            <page string="Containers" name="containers"
                                  attrs="{'invisible': [('is_outbound', '=', True)]}">
                                <group>
                                    <field name="is_master"/>
                                    <field name="container_line_ids">
                                        <tree editable="bottom">
                                            <!--                                            <field name="name"/>-->
                                            <!--                                            <field name="container_size"/>-->
                                            <field name="container_no"/>
                                            <field name="seal_no"/>
                                            <field name="gross_weight"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                            <!--                            <page string="Notes" decoration-danger="notes">-->
                            <!--                                <label for="notes"/>-->
                            <!--                                <field name="notes"/>-->
                            <!--                            </page>-->
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

