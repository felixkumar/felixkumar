<odoo>
    <data>
        <record id="tracking_order_form" model="ir.ui.view">
            <field name="name">tracking.order.form</field>
            <field name="model">tracking.wizard</field>
            <field name="arch" type="xml">
                <form string="Track Order Details">
                    <sheet>
                        <group>
                            <group>
                                <field name="port_loading_id"/>
                                <field name="port_shipping_id"/>
                            </group>
                            <group>
                                <field name="transport"/>
                                <field name="stage_id"/>
                            </group>
                            <field name="freight_tracking_ids">
                                <tree editable="bottom">
                                    <field name="location_id"/>
                                    <field name="description"/>
                                    <field name="Date"/>
                                </tree>
                            </field>
                        </group>
                        <footer>
                            <button string="Cancel" class="btn-default" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tracking_wizard_form" model="ir.ui.view">
            <field name="name">tracking.wizard.form</field>
            <field name="model">tracking.wizard</field>
            <field name="arch" type="xml">
                <form string="Track Order">
                    <group>
                        <field name="freight_id"/>
                    </group>
                    <footer>
                        <button string="Track Order" name="action_track" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="tracking_wizard_action" model="ir.actions.act_window">
            <field name="name">Track Order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tracking.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="tracking_wizard_form"/>
            <field name="target">new</field>
        </record>

<!--        <menuitem id="menu_track_order_root" name="Shipping Operation" parent="menu_freight_root" sequence="11"/>-->

<!--        <menuitem id="menu_track_order"-->
<!--                  name="Track Order"-->
<!--                  parent="menu_track_order_root"-->
<!--                  action="tracking_wizard_action"-->
<!--                  sequence="1"/>-->
    </data>
</odoo>