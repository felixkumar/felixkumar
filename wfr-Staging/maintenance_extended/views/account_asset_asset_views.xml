<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_view_asset_form_inherit_maintenance" model="ir.ui.view">
        <field name="name">account.asset.asset.form.inherit.maintenance</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="maintenance_equipment_ids" widget="many2many_tags" context="{'is_asset_record': True}"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" name="open_maintenance_equipment" type="object" icon="fa-wrench">
                    <field string="Maintenance" name="maintenance_equipment_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
