<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_view_kanban_inherit" model="ir.ui.view">
            <field name="name">module.view.kanban.inherit</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.module_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_immediate_install']" position="after">
                    <button type="object" class="btn btn-primary btn-sm" name="button_immediate_upgrade"
                            states="installed" groups="base.group_system">Upgrade
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>