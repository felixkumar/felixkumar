<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_tus" model="ir.ui.view">
        <field name="name">hr.employee.form.tus</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_hourly_cost.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='hourly_cost']" position="after">
                <field name="hourly_wage"/>
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="warehouse_id"/>
            </xpath>
            <xpath expr="//group[@name='active_group']/field[@name='user_id']" position="after">
                <field name="alias_name"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree_inherit_tus" model="ir.ui.view">
        <field name="name">hr.employee.tree.tus</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="alias_name" optional="hide" string="Alias"/>
            </xpath>
        </field>
    </record>


</odoo>