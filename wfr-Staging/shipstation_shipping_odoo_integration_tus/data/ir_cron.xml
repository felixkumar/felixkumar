<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record model="ir.cron" id="export_website_shipment_from_odoo_to_shipstation_cronjob">
            <field name="name">Shipstation : Export Website Shipment</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="user_id">1</field>
            <field name="state">code</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="code">model.export_website_delivery_order_using_cron()</field>
        </record>

        <record model="ir.cron" id="import_website_shipment_from_shipstation_to_odoo_cronjob">
            <field name="name">Shipstation : Import Exported Website Shipment</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="user_id">1</field>
            <field name="state">code</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="code">model.import_website_exported_delivery_order_using_cron()</field>
        </record>

        <record model="ir.cron" id="update_tracking_number_sale_obl_cron">
            <field name="name">Shipstation : Update Tracking Number In Sale And on OBL</field>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="user_id">1</field>
            <field name="state">code</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="code">model.action_update_tracking_number()</field>
        </record>
    </data>
</odoo>