<?xml version="1.0"?>
<odoo>
    <record id="product_template_view_form_normal_inherit_shipstation_tus" model="ir.ui.view">
        <field name="name">product.template.view.form.normal.inherit.shipstation.tus</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="header" position="inside">
                <button name="is_get_locked_product" string="Lock" class="oe_highlight" type="object"
                        attrs="{'invisible': [('is_locked', '=', True)]}"
                        groups="!user_warehouse_restriction.user_warehouse_restriction_group_user"/>
                <button name="is_get_locked_product" string="Unlock" class="oe_highlight" type="object"
                        attrs="{'invisible': [('is_locked', '!=', True)]}"
                        groups="!user_warehouse_restriction.user_warehouse_restriction_group_user"/>
            </xpath>
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="is_locked" invisible="1"/>
                <field name="identical_sku" attrs="{'readonly': [('is_locked', '=', True)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
