<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_sale_view_order_form" model="ir.ui.view">
        <field name="name">inherit.sale.view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shipstation_order_id']" position="after">
                <field name="carrier_tracking_ref"/>
            </xpath>
        </field>
    </record>

    <record id="action_update_carrier_tracking_number" model="ir.actions.server">
        <field name="name">Update Tracking Number</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
            records.action_update_tracking_number()
        </field>
    </record>

    <record id="action_update_carrier_tracking_number" model="ir.actions.server">
        <field name="name">Update Tracking Number</field>
        <field name="model_id" ref="warefor_3pl_tus.model_freight_freight"/>
        <field name="binding_model_id" ref="warefor_3pl_tus.model_freight_freight"/>
        <field name="state">code</field>
        <field name="code">
            records.action_update_tracking_number()
        </field>
    </record>

</odoo>
