<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

       <!-- Define a form view -->
        <record id="view_edi_error_log_form" model="ir.ui.view">
            <field name="name">edi.error.log.form</field>
            <field name="model">edi.error.log</field>
            <field name="arch" type="xml">
                <form string="EDI Error Log">
                    <sheet>
                        <group>
                            <field name="type"/>
                            <field name="error_id"/>
                            <field name="timestamp"/>
                            <field name="description"/>
                            <field name="edi_data"/>
                            <!-- Add more fields here as needed -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    <!-- Define a tree view -->
    <record id="view_edi_error_log_tree" model="ir.ui.view">
        <field name="name">edi.error.log.tree</field>
        <field name="model">edi.error.log</field>
        <field name="arch" type="xml">
            <tree string="EDI Error Logs" create="false">
                <field name="type"/>
                <field name="error_id"/>
                <field name="timestamp"/>
<!--                <field name="description"/>-->
            </tree>
        </field>
    </record>


    <record id="action_edi_error_log" model="ir.actions.act_window">
        <field name="name">EDI Error LOG</field>
        <field name="res_model">edi.error.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_edi_error_log"
              name="EDI Error LOG"
              parent="base_edi.menu_edi"
              action="action_edi_error_log"
              sequence="6"/>
</odoo>