<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ShipmentManifest_doc">
        <div class="page" style="page-break-before:always;font-size:10px;">
            <t t-call="web.layout">
                <div class="w-100"
                     style="background-color: #f2f2f2;width:100%;border: 1px solid #0e0d0d;margin: auto;font-weight: bold;">
                    <div style="width:100%;position:relative;top:3px;font-weight: bold;text-align:center;padding-bottom:4px;font-size:15px;">
                        SHIPMENT MANIFEST
                    </div>
                </div>
                <t t-set="line_length" t-value="1"/>
                <table style="width:100%;padding-top:20px;cellspacing=0 cellpadding=0">
                    <tr>
                        <th style="vertical-align: baseline;text-align:left;text-wrap: nowrap;font-size:10px;width:6%;">
                            SHIP TO
                        </th>
                        <td style="vertical-align: baseline;text-align:left;font-size:10px;width:18%;padding-left:1%;">
                            <div>
                                <b>
                                    <t t-esc="o.outbound_partner_id.name"/>
                                </b>
                            </div>
                            <div>
                                <t t-esc="o.outbound_partner_id.street"/>
                            </div>
                            <div>
                                <t t-esc="o.outbound_partner_id.street2"/>
                            </div>
                            <div>
                                <t t-esc="o.outbound_partner_id.city"/>
                            </div>
                        </td>
                        <td style="vertical-align:baseline;text-align:left;font-size:10px;width:18%;padding-left:3%;">
                            <div>
                                <b>BOL/LOAD ID</b>
                            </div>
                            <div>
                                <b>PURCHASE ORDER</b>
                            </div>
                            <div>
                                <b>FINAL DESTINATION</b>
                            </div>
                            <div>
                                <b>DISPATCH DATE</b>
                            </div>
                        </td>
                        <td style="vertical-align:baseline;text-align:left;font-size:10px;width:20%;padding-left:10px;">
                            <div>
                                 <t t-if="o.bol_number">
                                    <t t-esc="o.bol_number"/>
                                </t>
                                <t t-else="">
                                    <span style="visibility:hidden;">gfggjhgj</span>
                                </t>
                            </div>
                            <div>
                                <t t-esc="po_number"/>
                            </div>
                            <div style="vertical-align:baseline;text-align:left;">
                                <t t-if="o.final_destination_code">
                                    <t t-esc="o.final_destination_code"/>
                                </t>
                                <t t-else="">
                                    <span style="visibility:hidden;">gfggjhgj</span>
                                </t>
                            </div>
                            <div>
                                <t t-if="o.delivery_eta">
                                    <t t-esc="o.delivery_eta and o.delivery_eta.strftime('%m/%d/%y')"/>
                                </t>
                                <t t-else="">
                                    <span style="visibility:hidden;">gfggjhgj</span>
                                </t>
<!--                                <t t-esc="o.delivery_eta and o.delivery_eta.strftime('%m/%d/%y')"/>-->
                            </div>
                        </td>
                        <td style="vertical-align:baseline;text-align:left;font-size:10px;width:15%;padding-left:5%;"></td>
                        <td style="vertical-align:baseline;text-align:right;font-size:10px;width:9%;padding-left:0.5%;">
                            <div>
                                <b>CARRIER</b>
                            </div>
                            <div>
                                <br/>
                                <b>TRAILER</b>
                            </div>
                        </td>
                        <td colspan="3"
                            style="vertical-align:baseline;text-align:left;font-size:10px;width:24%;padding-left:7px;">
                            <div>
                                <t t-esc="o.carrier_flight.name"/>
                            </div>
                            <div>
                                <br/>
                                <t t-esc="o.trailer"/>
                            </div>
                        </td>
                    </tr>
                </table>
                <table style="width:100%;padding-top:15px;font-size:10px;cellspacing=0 cellpadding=0">
                    <tr>
                        <th style="vertical-align: baseline;text-align:left;text-wrap: nowrap;width:6%;">Pallet #
                        </th>
                        <th style="vertical-align: baseline;text-align:left;width:18%;padding-left:1%;">Pallet
                            <br/>
                            SSCC-18
                        </th>
                        <th style="vertical-align: baseline;text-align:left;width:18%;padding-left:3%;">Pallet Type</th>
                        <th style="vertical-align: baseline;text-align:left;width:10%;padding-left:10px;">Vendor
                            <br/>
                            Item #
                        </th>
                        <th style="vertical-align: baseline;text-align:left;width:15%;padding-left:5%;">Item #</th>
                        <th style="vertical-align: baseline;text-align:end;width:9%;padding-left:0.5%;">QTY<br/>Cases
                        </th>
                        <th style="vertical-align: baseline;text-align:end;width:8%;">QTY<br/>Units
                        </th>
                        <th style="vertical-align: baseline;text-align:end;width:8%;">Volume<br/>(CuFt)
                        </th>
                        <th style="vertical-align: baseline;text-align:end;width:8%;">Weight<br/>(Lbs)
                        </th>
                    </tr>
                    <t t-set="dict_line" t-value="o.grouped_lines_list(lines)"/>
                    <t t-foreach="dict_line.items()" t-as="line_values">
                        <t t-foreach="line_values[1]" t-as="line_value">
                            <t t-if="line_value">
                                <tr>
                                    <td style="vertical-align: baseline;text-align:end;text-wrap: nowrap;width:6%;padding-right:5px;">
                                        <span t-esc="line_values[0]"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:left;width:18%;padding-left:1%;">
                                        <t t-esc="line_value['sscc_18_char'] or ''"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:left;width:18%;padding-left:3%;">
                                        <t t-esc="line_value['pallet_type']"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:left;width:10%;padding-left:10px;">
                                        <t t-esc="line_value.get('default_code')"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:left;width:15%;padding-left:5%;">
                                        <t t-esc="line_value['item_customer_number']"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:end;width:9%;padding-left:0.5%;">
                                        <t t-esc="line_value['qty_case']"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:end;width:8%;">
                                        <t t-esc="line_value['qty_unit']"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:end;width:8%;">
                                        <t t-esc="'{:,.2f}'.format(line_value['product_volume'])"/>
                                    </td>

                                    <td style="vertical-align: baseline;text-align:end;width:8%;">
                                        <t t-esc="'{:,.2f}'.format(line_value['net_weight'])"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-set="line_length" t-value="line_length + 1"/>
                    </t>
                    <!--<tr style="font-weight:bold;">
                        <td style="vertical-align: baseline;text-align:left;text-wrap: nowrap;width:6%;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:18%;padding-left:1%;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:18%;padding-left:3%;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:10%;padding-left:10px;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:15%;padding-left:5%;"></td>
