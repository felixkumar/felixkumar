                    <tr style="font-weight:bold;">
                        <td style="vertical-align: baseline;text-align:left;text-wrap: nowrap;width:6%;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:18%;padding-left:1%;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:18%;padding-left:3%;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:10%;padding-left:10px;"></td>
                        <td style="vertical-align: baseline;text-align:left;width:15%;padding-left:5%;"></td>
                        <td style="vertical-align: baseline;text-align:end;width:9%;padding-left:0.5%;">
                            <t t-set="total_qty_case"
                               t-value="sum(int(line.qty_carton or 0) for line in lines)"/>
                            <t t-esc="'{:,d}'.format(total_qty_case and int(total_qty_case) or 0)"/>
                        </td>
                        <td style="vertical-align: baseline;text-align:end;width:8%;">
                            <t t-set="total_qty_unit"
                               t-value="sum(line.total_quantity for line in lines)"/>
                            <t t-set="total_unit" t-value="round(total_qty_unit)"/>
                            <t t-esc="'{:,d}'.format(total_unit and int(total_unit) or 0)"/>
                        </td>
                        <td style="vertical-align: baseline;text-align:end;width:8%;">
                            <t t-set="total_volume"
                               t-value="sum(line.product_volume for line in lines)"/>
                            <t t-esc="'{:,.2f}'.format(total_volume)"/>
                        </td>
                        <td style="vertical-align: baseline;text-align:end;width:8%;">
                            <t t-set="total_weight"
                               t-value="sum(line.net_weight for line in lines)"/>
                            <t t-esc="'{:,.2f}'.format(total_weight)"/>
                        </td>
                    </tr>
                </table>
                <style>
                    span#oe_neutralize_banner {
                    display:none !important;
                    }
                </style>
            </t>
        </div>
    </template>

