<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="house_bol_wizard_view_form" model="ir.ui.view">
        <field name="name">house.bol.wizard.view.form</field>
        <field name="model">house.bol.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
<!--                        <field name="skip_signature"/>-->
                        <field name="freight_record" attrs="{'invisible':[('skip_signature','=',True)]}"/>
                    </group>
                    <group>
                        <field name="freight_record"/>
                    </group>
                    <group>
                        <group id="check" string="Freight Charge Terms">
                            <field name="is_house_fr_prepaid"/>
                            <field name="is_house_fr_collect"/>
                            <field name="is_house_fr_3rd_party"/>
                        </group>
                        <group id="check1" string="Fee Terms">
                            <field name="is_house_fee_prepaid"/>
                            <field name="is_house_fee_collect"/>
                            <field name="is_house_check"/>
                        </group>
                    </group>
                    <group class="col-6">
                        <field name="house_cod_amount"/>
                    </group>

                    <group>
                        <group>
                            <field name="house_date"/>
                        </group>
                        <group>
                            <field name="house_pickup_date"/>
                        </group>
                    </group>
                    <group id="check" string="Trailer Loaded">
                        <field name="is_house_by_shipper_trai"/>
                        <field name="is_house_by_driver_trai"/>
                    </group>
                    <group id="check" string="Freight Counted">
                        <field name="is_house_by_shipper_freight"/>
                        <field name="is_house_by_driver_freight"/>
                        <field name="is_house_by_pieces"/>
                    </group>
                    <group>
                        <field name="house_shipper_sign" widget="signature"/>
                    </group>
                    <group>
                        <field name="house_carrier_sign" widget="signature"/>
                    </group>
                </sheet>
                <footer>
                    <button name="print_report_house_bol" type="object" string="Print" class="oe_highlight"/>
                    <button name="cancel_btn" string="Cancel" special="cancel" data-hotkey="z" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
