<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.view.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" options="inside">
                <button name="button_approve" type="object" string="Approve Order" states='to_approve'
                        class="oe_highlight" groups="sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" options="inside">
                <!-- <xpath expr="//button[@name='action_view_invoice']" options="before">-->
                <button name="action_view_service_invoice" type="object" class="oe_stat_button"
                        icon="fa-pencil-square-o" attrs="{'invisible': [('service_invoice_count', '=', 0)]}">
                    <field name="service_invoice_count" widget="statinfo" string="Service Invoices"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
