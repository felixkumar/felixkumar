<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--    Form view for python code execution     -->
        <record id="form_view_python_code_execution" model="ir.ui.view">
            <field name="name">form.view.python.code.execution</field>
            <field name="model">python.code.execution</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Python Code Execution">
                    <sheet>
                        <div colspan="4">
                            <span name="Name">
                                <separator string="Name"/>
                                <field name="code_name" colspan="4" nolabel="1" required="1"/>
                            </span>
                        </div>

                        <separator colspan="4" string="Prepare your python code below and click on Run button."/>
                        <group colspan="4">
                            <field name="code_exec" widget="ace" options="{'mode': 'python'}"/>
                        </group>
                        <group colspan="4">
                            <button name="python_code_execution" string="Run" type="object" icon="fa-play"/>
                        </group>
                        <group colspan="4">
                            <separator colspan="4" string="Result"/>
                            <field name="result" colspan="4" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--    Tree view for python code execution     -->
        <record id="tree_view_python_code_execution" model="ir.ui.view">
            <field name="name">tree.view.python.code.execution</field>
            <field name="model">python.code.execution</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Python Code">
                    <field name="code_name"/>
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>

        <!--    Action for python code execution    -->
        <record id="action_python_code_execution" model="ir.actions.act_window">
            <field name="name">Python Code Execute</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">python.code.execution</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="tree_view_python_code_execution"/>
        </record>

        <!--    Menu for python code execution    -->
        <menuitem parent="base.menu_administration"
                  id="menu_python_code_execution_root"
                  action="python_code_execution_pg.action_python_code_execution"/>
    </data>
</odoo>