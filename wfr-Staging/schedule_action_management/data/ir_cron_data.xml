<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">
        <record id="schedule_action_shipstation_management_action" model="ir.cron">
            <field name="name">Shipstation: Import Order, Create Quotation, Confirm Order</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="model_id" ref="model_ir_cron_management" />
            <field name="code">
source_record = env['ir.cron.management'].search([('code', '=', 'shipstation')], limit=1)
source_record._run_action()
            </field>
        </record>
    </data>
</odoo>
