<!--                <field name="sequence" widget="handle"/>-->
<!--            </xpath>-->
<!--        </field>-->
<!--    </record>-->

    <record id="product_template_attribute_value_description" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="attribute_value_description"/>
            </xpath>
        </field>
    </record>
</odoo>
