<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view_inherits">
        <field name="name">product.template.form.inherits</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!--            <xpath expr="//field[@name='attribute_line_ids']/tree/field[@name='attribute_id']" position="before">-->
            <!--                <field name="sequence" widget="handle"/>-->
            <!--            </xpath>-->
            <field name="website_sequence" position="after">
                <field name="web_product_title"/>
                <field name="website_product_description" string="Description"/>
                <field name="website_product_image" widget="image" class="oe_avatar"/>
            </field>
            <field name="alternative_product_ids" position="attributes">
                <attribute name="domain">['|', ('company_id', '=', company_id), ('company_id', '=', False)]</attribute>
            </field>
        </field>
    </record>

