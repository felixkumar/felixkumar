<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart_custom" name="Customized Shopping Cart">
        <t t-call="website.layout">
            <div id="wrap" class="h-100 bg-white">
                <div class="oe_website_sale ">
                    <div class="row oe_cart">
                        <div class="col-12 py-2 d-flex align-items-center border-bottom">
                            <div class="col-11 fw-500 text-center" style="font-size:16px;">Your Cart</div>
                            <a class="col-1 btn d-flex justify-content-center" href="/shop"><span class="d-block" style="transform:rotate(45deg);height:12px;width:12px;">+</span></a>
                        </div>
                        <t t-call="header_layout.sale_cart_lines"/>

                        <div class="col-12 col-xl-8 oe_cart">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div t-if="abandoned_proceed or access_token" class="mt8 mb8 alert alert-info"
                                         role="alert"> <!-- abandoned cart choices -->
                                        <t t-if="abandoned_proceed">
                                            <p>Your previous cart has already been completed.</p>
                                            <p t-if="website_sale_order">Please proceed your current cart.</p>
                                        </t>
                                        <t t-if="access_token">
                                            <p>This is your current cart.</p>
                                            <p>
                                                <strong>
                                                    <a t-attf-href="/shop/cart/?access_token=#{access_token}&amp;revive=squash">
                                                        Click here
                                                    </a>
                                                </strong>
                                                if you want to restore your previous cart. Your current cart will be
                                                replaced with your previous cart.
                                            </p>
                                            <p>
                                                <strong>
                                                    <a t-attf-href="/shop/cart/?access_token=#{access_token}&amp;revive=merge">
                                                        Click here
                                                    </a>
                                                </strong>
                                                if you want to merge your previous cart into current cart.
                                            </p>
                                        </t>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="oe_structure" id="oe_structure_website_sale_cart_1"/>
                                </div>
                            </div>
                        </div>
                        <div t-if="website_sale_order and website_sale_order.website_order_line" id="o_cart_summary">
                            <t t-call="header_layout.cart_summary_custom"/>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_website_sale_cart_2"/>
            </div>
        </t>
    </template>

    <template id="sale_cart_lines" name="Shopping Cart: Lines">
        <div t-if="not website_sale_order or not website_sale_order.website_order_line"
             class="js_cart_lines col-12 text-center d-flex justify-content-center flex-column">
            <div style="font-size:20px;font-weight:500;">Your cart is empty!</div>
            <div class="my-5">
                <a role="button" href="/shop" class="btn btn-primary shop_all text-uppercase mb32">
                    Shop now
                </a>
            </div>
        </div>
        <t t-if='website_sale_order'>
            <div t-if='website_sale_order._get_shop_warning(clear=False)' class="alert alert-warning" role="alert">
                <strong>Warning!</strong>
                <t t-esc='website_sale_order._get_shop_warning()'/>
            </div>
        </t>
        <t t-foreach="website_sale_order.website_order_line" t-as="line">
            <div class="d-flex px-5 py-4 border-bottom in_cart">
                <div class="col-2 col-lg-1">
                    <span t-if="line._is_not_sellable_line() and line.product_id.image_128">
                        <img t-att-src="image_data_uri(line.product_id.image_128)"
                             class="img"
                             t-att-alt="line.name_short" height="100" width="100" style="border-radius:4px;"/>
                    </span>
                    <span t-else=""
                          t-field="line.product_id.image_128"
                          t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'img img-fluid fw-500', 'style': 'height:100px;width:100px;border-radius:4px;'}"/>

                </div>
                <div class="d-flex col-lg-11 col-10 flex-column ps-3 fw-500" style="font-size:20px;color:#282828;">
                    <div class="d-flex justify-content-between">
                        <span t-if="line.product_id.web_product_title" t-field="line.product_id.web_product_title"
                              class="fw-500 " style="font-size:20px;color:#282828;"/>
                        <span t-else="" t-field="line.product_id.name" class="fw-500 "
                        />
                        <t t-set="combination"
                           t-value="line.product_id.product_template_attribute_value_ids +
                    line.product_no_variant_attribute_value_ids"/>
                        <t t-set="combination_info"
                           t-value="line.product_id.product_tmpl_id._get_combination_info(combination, pricelist=website_sale_order.pricelist_id, add_qty=line.product_uom_qty)"/>
                        <div class="fw-500">
                            <t t-set="combination"
                               t-value="line.product_id.product_template_attribute_value_ids +
                    line.product_no_variant_attribute_value_ids"/>
                            <t t-set="combination_info"
                               t-value="line.product_id.product_tmpl_id._get_combination_info(combination, pricelist=website_sale_order.pricelist_id, add_qty=line.product_uom_qty)"/>
                            <t groups="account.group_show_line_subtotals_tax_excluded">
                                <span t-field="line.price_reduce_taxexcl" style="white-space: nowrap;"
                                      t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                            </t>
                            <t groups="account.group_show_line_subtotals_tax_included">
                                <span t-field="line.price_reduce_taxinc" style="white-space: nowrap;"
                                      t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                            </t>
                            <t t-if="line.discount">
                                <del t-attf-class="#{'text-danger mr8'}" style="white-space: nowrap;"
                                     t-esc="combination_info['list_price']"
                                     t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                            </t>
                            <small t-if="not line._is_not_sellable_line() and line.product_id.base_unit_price"
                                   class="cart_product_base_unit_price d-block text-muted"
                                   groups="website_sale.group_show_uom_price">
                                <t t-call='website_sale.base_unit_price'>
                                    <t t-set='product' t-value='line.product_id'/>
                                </t>
                            </small>
                        </div>


                    </div>
                    <div class="d-flex">
                        <span class="custom-text-muted fw-500" t-field="line.product_id.website_product_description"
                              style="font-size: 14px;"/>

                    </div>
                    <div class="d-flex mt-3 justify-content-between align-items-end" style="font-size: 16px;">
                        <div t-attf-class="d-flex bg-white css_quantity oxf_css_quantity input-group p-0 text-center {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} me-2 mb-2 align-middle #{'input-group-lg' if ctaSizeBig else ''}"
                             contenteditable="false" style="border-radius:4px;">
                            <a t-attf-href="#" class="btn btn-link js_add_cart_json px-0 text-center"
                               aria-label="Remove one"
                               title="Remove one" style="width:20px;">
                                <i class="fa fa-minus fw-normal bg-white" style="color:#282828;"></i>
                            </a>
                            <div class="px-0 text-center " style="background-color:#EAECEC;opacity:0.4;width:20px;">
                                <input type="text" class="js_quantity form-control quantity text-center" data-min="1" name="add_qty"
                                       t-att-value="int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty"
                                       t-att-data-line-id="line.id" t-att-data-product-id="line.product_id.id"
                                       style="padding-block:0;padding-inline:0;height:100% !important;background-color:#EAECEC;opacity:0.4;color:#282828;min-width:20px;"/>
                            </div>
                            <a t-attf-href="#" class="btn btn-link js_add_cart_json px-0 text-center"
                               aria-label="Add one"
                               title="Add one" style="width:20px;">
                                <i class="fa fa-plus bg-white fw-normal" style="color:#282828;"></i>
                            </a>
                        </div>


                        <div class="custom-text-muted">
                            <a href='#' aria-label="Remove from cart" title="Remove from cart"
                               class='js_delete_product no-decoration'>
                                <i class='fa fa-trash-o custom-text-muted' style="height:16px;width:14px;"></i>
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </t>
        <div t-if="suggested_products" class="border-top pt-4" style="background-color:#F8F7F7;">
            <span class="px-5 fw-500 fs-14" style="color:black;">You may also like</span>
            <t t-foreach="suggested_products" t-as="product">
                <div class="d-flex px-5 py-5 border-bottom ">
                    <div class="col-lg-1 col-2">
                        <span t-if="product.image_128">
                            <img t-att-src="image_data_uri(product.image_128)"
                                 class="img"
                                 t-att-alt="product.name" height="100" width="100" style="border-radius:4px;"/>
                        </span>
                        <span t-else=""
                              t-field="product.image_128"
                              t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'img img-fluid fw-500', 'style': 'height:100px;width:100px;border-radius:4px;min-height:100px;min-width:100px;max-height:100px;max-width:100px;'}"/>
                    </div>
                    <div class="d-flex col-lg-11 col-10 flex-column ps-3 fw-500" style="font-size:20px;color:#282828;">
                        <div class="d-flex justify-content-between">
                            <span t-if="product.web_product_title" t-field="product.web_product_title"
                                  class="fw-500 " style="font-size:20px;color:#282828;"/>
                            <span t-else="" t-field="product.name" class="fw-500 "
                            />
                            <t t-set="combination"
                               t-value="product.product_template_attribute_value_ids"/>
                            <t t-set="combination_info"
                               t-value="product.product_tmpl_id._get_combination_info(combination, pricelist=website_sale_order.pricelist_id, add_qty='1')"/>
                            <div class="fw-500">
                                <t groups="account.group_show_line_subtotals_tax_excluded">
                                    <span t-field="line.price_reduce_taxexcl" style="white-space: nowrap;"
                                          t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                                </t>
                                <t groups="account.group_show_line_subtotals_tax_included">
                                    <span t-field="line.price_reduce_taxinc" style="white-space: nowrap;"
                                          t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                                </t>
                                <t t-if="product.base_unit_price"
                                   class="cart_product_base_unit_price d-block text-muted"
                                   groups="website_sale.group_show_uom_price">
                                    <t t-call='website_sale.base_unit_price'/>
                                </t>
                            </div>


                        </div>
                        <div class="d-flex">
                            <span class="custom-text-muted fw-500" t-field="line.product_id.website_product_description"
                                  style="font-size: 14px;"/>

                        </div>
                        <div class="d-flex mt-3" style="font-size: 16px;">
                             <input class="js_quantity" name="product_id" t-att-data-product-id="product.id" type="hidden" />
                            <button t-if="product._website_show_quick_add()"
                               role="button" class="btn p-0 js_add_suggested_products fw-bold text-uppercase w-100"
                            style="background-color:#91493C; color:white;height:36px;border-radius:4px;letter-spacing: 1.68px;">
                               Add
                            </button>

<!--                            <button id="add_to_cart_button" type="button" role="button"-->
<!--                                    class="btn text-center fw-bold text-uppercase o_wish_add w-100 p-0"-->
<!--                                    style="background-color:#91493C; color:white;height:36px;border-radius:4px;letter-spacing: 1.68px;">-->
<!--                                Add-->
<!--                            </button>-->
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>
    <template id="cart_summary_custom" name="Cart - Summary">
        <div class="px-5 py-4 mb-0 bg-white custom_cart_summary col-12">
            <div class="d-flex justify-content-between fw-500" style="font-size:20px;">
                <span>Subtotal</span>
                <div>
                    <span t-field="website_sale_order.amount_total" class="monetary_field"
                          t-options='{"widget": "monetary", "display_currency": website_sale_order.pricelist_id.currency_id}'/>
                    <spna t-field="website_sale_order.pricelist_id.currency_id.name"/>
                </div>
            </div>
            <t t-set="redirect_to_sign_in"
               t-value="website.account_on_checkout == 'mandatory' and website.is_public_user()"/>
            <t t-set="redirect_url"
               t-value="'/web/login?redirect=/shop/checkout' if redirect_to_sign_in else '/shop/checkout?express=1'"/>
            <a role="button" t-if="website_sale_order and website_sale_order.website_order_line"
               class="btn w-100 mt-3 fw-bold text-uppercase"
               t-attf-href="{{redirect_url}}"
               style="height: 56px;border-radius: 4px;background: #475656;color:white;font-size: 16px;letter-spacing: 1.92px;">
                <t t-if="redirect_to_sign_in">
                    <span>Sign In</span>
                </t>
                <t t-else="">
                    <span>Proceed to Checkout</span>
                </t>
            </a>
        </div>
    </template>
</odoo>