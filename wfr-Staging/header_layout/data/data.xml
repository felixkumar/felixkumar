<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="review_page" model="website.page">
        <field name="is_published">True</field>
        <field name="url">/reviews</field>
        <field name="view_id" ref="website_review_page"/>
        <field name="track">True</field>
    </record>

    <!-- Create Filter Record -->
    <record id="dynamic_snippet_category_filter" model="ir.filters">
        <field name="name">Oxford Category</field>
        <field name="model_id">product.public.category</field>
        <field name="user_id" eval="False"/>
        <field name="domain">[('child_id','=',False)]</field>
        <field name="sort">['sequence asc']</field>
    </record>

    <!-- Create Snippet Filter Records -->
    <record id="dynamic_filter_category_oxf" model="website.snippet.filter">
        <field name="filter_id" ref="header_layout.dynamic_snippet_category_filter"/>
        <field name="field_names">name,product_tmpl_ids,image_512</field>
        <field name="limit" eval="16"/>
        <field name="name">Oxford Category</field>
    </record>


    <!-- Create Filter Record -->
    <record id="dynamic_snippet_oxf_products_template_filter" model="ir.filters">
        <field name="name">Oxf Products</field>
        <field name="model_id">product.template</field>
        <field name="user_id" eval="False"/>
        <field name="domain">[('website_published', '=', True)]</field>
        <field name="sort">['website_sequence asc']</field>
        <field name="action_id" ref="website.action_website"/>
    </record>
    <record id="dynamic_filter_oxf_products_template" model="website.snippet.filter">
        <field name="filter_id" ref="header_layout.dynamic_snippet_oxf_products_template_filter"/>
        <field name="field_names">website_url,web_product_title,description,name</field>
        <field name="limit" eval="16"/>
        <field name="name">Oxf Products</field>
    </record>


