<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tus_theme_prime.product_details_extended" model="ir.ui.view">
        <field name="name">product_details_extended</field>
        <field name="inherit_id" search="[('key', '=', 'theme_prime.product')]"/>
        <field name="type">qweb</field>
        <field name="priority" eval="35"/>
        <field name="active">True</field>
        <field name="key">tus_theme_prime.product_details_extended</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('tp-breadcrumb-wrapper')]" position="replace">
                <t t-if="website.id == 4">
                </t>
            </xpath>
            <xpath expr="//div[hasclass('js_main_product')]/hr" position="replace">
                <t t-if="website.id == 4">
                </t>
            </xpath>
            <xpath expr="//button[hasclass('o_add_compare_dyn')]" position="replace">
                <t t-if="website.id == 4">
                </t>
            </xpath>
            <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="t-attf-class" add="w-100 add_to_cart_wrap" separator=" "/>
                </t>
            </xpath>
<!--            <xpath expr="//hr" position="attributes">-->
<!--                <t t-if="website.id == 4">-->
<!--                    <attribute name="class" add="m-0 mt16 mb16" separator=" "/>-->
<!--                </t>-->
<!--            </xpath>-->
            <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
                <t t-if="website.id == 4">
                    <attribute name="t-attf-class" add="w-100 add_to_cart_wrap" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//a[@id='add_to_cart']" position="replace">
                <t t-if="website.id == 4">
                    <a role="button" id="add_to_cart" data-animation-selector=".product_detail_img"
                       class="btn btn-primary btn-lg text-uppercase js_check_product custom_add_to_cart bg-475656 a-submit flex-grow-1"
                       href="#">
                        Add to Cart
                    </a>
                </t>
            </xpath>
            <xpath expr="//div[@id='product_details']/hr" position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="class" add="mb-0 mt-4" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-hook-product-tabs')]" position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="class" add="d-none" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-hook-accessory-products')]" position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="class" add="d-none" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-sticky-add-to-cart')]" position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="class" add="d-none" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[@id='o_product_terms_and_share']" position="before">
                <t t-if="website.id == 4">
                    <div class="container-fluid px-0 tp-hook-product-tabs">
                        <div class="row g-0">
                            <div class="col-12">
                                <t t-call="tus_theme_prime.product_details_accordion"/>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <record id="tus_theme_prime.product_tabs" model="ir.ui.view">
        <field name="name">product_tabs</field>
        <field name="inherit_id" search="[('key', '=', 'theme_prime.product_tabs')]"/>
        <field name="type">qweb</field>
        <field name="priority" eval="35"/>
        <field name="active">True</field>
        <field name="key">tus_theme_prime.product_tabs</field>
        <field name="arch" type="xml">
            <xpath expr="div[hasclass('tp-product-details-tab')]" position="replace">
                <t t-if="website.id == 4">
                    <div class="tp-product-details-tab">
                        <ul class="nav nav-tabs justify-content-center" role="tablist">
                            <li t-if="is_view_active('website_sale_comparison.product_attributes_body')"
                                class="nav-item o_not_editable">
                                <a class="nav-link" data-bs-toggle="tab" href="#tp-product-specification-tab" role="tab"
                                   aria-selected="false">
                                    <span class="fa fa-sliders me-1"/>
                                    Specifications
                                </a>
                            </li>
                            <t t-set="product_documents_ids" t-value="product.sudo().dr_document_ids"/>
                            <li t-if="product_documents_ids" class="nav-item o_not_editable">
                                <a class="nav-link" data-bs-toggle="tab" href="#tp-product-documents-tab" role="tab"
                                   aria-selected="false">
                                    <span class="fa fa-file-pdf-o me-1"/>
                                    Documents
                                </a>
                            </li>
                            <li t-if="is_view_active('website_sale.product_comment')" class="nav-item o_not_editable">
                                <a class="nav-link" data-bs-toggle="tab" href="#tp-product-rating-tab" role="tab"
                                   aria-selected="false">
                                    <span class="fa fa-comments-o me-1"/>
                                    Reviews &amp; Rating
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <!-- Specifications -->
                            <div t-if="is_view_active('website_sale_comparison.product_attributes_body')"
                                 class="tab-pane fade" id="tp-product-specification-tab" role="tabpanel">
                                <section class="container border-0" id="product_full_spec">
                                    <t t-set="categories"
                                       t-value="product.valid_product_template_attribute_line_ids._prepare_categories_for_display()"/>
                                    <t t-if="categories">
                                        <div class="row pt-2 pb-4 m-0">
                                            <div class="col-12 col-lg-8 offset-lg-2" id="product_specifications">
                                                <table class="table mb-0 border">
                                                    <t t-foreach="categories" t-as="categ">
                                                        <t t-if="len(categories) > 1">
                                                            <tr class="shadow-sm text-bg-light">
                                                                <th class="text-start" t-att-colspan="2">
                                                                    <span t-if="categ" t-field="categ.name"/>
                                                                    <span t-else="">Uncategorized</span>
                                                                </th>
                                                            </tr>
                                                        </t>
                                                        <tr t-foreach="categories[categ].filtered(lambda l: len(l.value_ids) > 1)"
                                                            t-as="ptal">
                                                            <td>
                                                                <span t-field="ptal.attribute_id.name"/>
                                                            </td>
                                                            <td>
                                                                <t t-foreach="ptal.value_ids" t-as="pav">
                                                                    <span t-field="pav.name"/>
                                                                    <t t-if="not pav_last">or</t>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                        <t t-set="single_value_attributes"
                                                           t-value="categories[categ]._prepare_single_value_for_display()"/>
                                                        <tr t-foreach="single_value_attributes" t-as="attribute">
                                                            <td>
                                                                <span t-field="attribute.name"/>
                                                            </td>
                                                            <td>
                                                                <t t-foreach="single_value_attributes[attribute]"
                                                                   t-as="ptal">
                                                                    <span t-field="ptal.product_template_value_ids._only_active().name"/>
                                                                    <t t-if="not ptal_last">,</t>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </table>
                                            </div>
                                        </div>
                                    </t>
                                    <div class="p-4 text-center" t-else="">
                                        No Specifications
                                    </div>
                                </section>
                            </div>
                            <!-- Documents -->
                            <div t-if="product_documents_ids" class="tab-pane fade" id="tp-product-documents-tab"
                                 role="tabpanel">
                                <div class="container">
                                    <div class="row pt-2 pb-4 m-0">
                                        <t t-foreach="product_documents_ids" t-as="document">
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 my-2">
                                                <div class="d-flex align-items-center p-2 border">
                                                    <div class="o_image" t-att-data-mimetype="document.mimetype"/>
                                                    <div class="ms-2 text-truncate">
                                                        <div t-field="document.name" t-att-title="document.name"/>
                                                        <a t-attf-href="/web/content/#{document.id}?download=true"
                                                           class="link-primary d-inline-block mt-1">
                                                            <i class="fa fa-download"/>
                                                            Download
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- Rating -->
                            <div t-if="is_view_active('website_sale.product_comment')" class="tab-pane fade"
                                 id="tp-product-rating-tab" role="tabpanel">
                                <div class="o_shop_discussion_rating container">
                                    <section class="container">
                                        <div class="row m-0 mt-2">
                                            <div class="col-lg-8 offset-lg-2">
                                                <t t-call="portal.message_thread">
                                                    <t t-set="object" t-value="product"/>
                                                    <t t-set="display_rating" t-value="True"/>
                                                    <t t-set="message_per_page" t-value="10"/>
                                                </t>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <template id="tus_theme_prime.product_details_accordion" active="True">
        <div id="detailsCollapse" class="accordion" role="tablist">
            <style>
                #detailsCollapse{
                .card ,.card-header,.card-body {
                background-color:transparent !important;
                border:none;
                }
                .card-header[aria-expanded="true"] .accordion-icon{
                transform:rotate(45deg);
                }
                .card-body{
<!--                    ul{-->
<!--                    padding-left: 1rem !important;-->
<!--                    }-->
                    section{
                    padding: 0 !important;
                    }
                }
                }
            </style>
            <div class="card" data-name="Item">
                <a href="#" role="tab" data-bs-toggle="collapse" aria-expanded="false" class="collapsed card-header px-2"
                   data-bs-target="#collapse0">
                    <div class="d-flex flex-row justify-content-between flex-wrap align-items-center fs-14"
                         style="height:24px;color:#282828 !important;">
                        <span class="text-uppercase fw-500">Overview</span>
                        <span class="accordion-icon fs-12">+</span>
                    </div>
                </a>
                <div id="collapse0" class="collapse" role="tabpanel">
                    <div class="card-body px-2 pb8">
                        <div t-field="product.website_description" class="fs-14 fw-normal"
                             style="color: #535353 !important;"/>
                    </div>
                </div>
            </div>

            <hr class="my-0"/>

            <t t-foreach="product.dr_product_tab_ids" t-as="tab">
                <div class="card" data-name="Item">
                    <a href="#" role="tab" data-bs-toggle="collapse" aria-expanded="false" class="collapsed card-header px-2"
                       t-att-data-bs-target="'#collapse%s' % tab.id">
                        <div class="d-flex flex-row justify-content-between flex-wrap align-items-center fs-14 "
                             style="height:24px;color:#282828 !important;">
                            <span class="text-uppercase fw-500" t-field="tab.name"/>
                            <span class="accordion-icon fs-12">+</span>
                        </div>
                    </a>
                    <div t-attf-id="collapse#{tab.id}" class="collapse" role="tabpanel">
                        <div class="card-body px-2 pb8">
                            <div class="p-0 m-0 fs-14 fw-normal " t-field="tab.content"
                                 style="color: #535353 !important;"/>
                        </div>
                    </div>
                </div>
                <hr class="my-0"/>
            </t>
        </div>
    </template>

    <record id="tus_theme_prime.cart_lines" model="ir.ui.view">
        <field name="name">cart_lines</field>
        <field name="inherit_id" search="[('key', '=', 'theme_prime.cart_lines')]"/>
        <field name="type">qweb</field>
        <field name="priority" eval="35"/>
        <field name="active">True</field>
        <field name="key">tus_theme_prime.cart_lines</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@t-if='not website_sale_order or not website_sale_order.website_order_line']"
                   position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="class" remove="alert alert-info" separator=" "/>
                    <attribute name="class" add="col-12 text-center" separator=" "/>
                </t>
            </xpath>
        </field>
    </record>

    <record id="tus_theme_prime.product_extra_fields" model="ir.ui.view">
        <field name="name">product_extra_fields</field>
        <field name="inherit_id" search="[('key', '=', 'theme_prime.product_extra_fields')]"/>
        <field name="type">qweb</field>
        <field name="priority" eval="35"/>
        <field name="active">True</field>
        <field name="key">tus_theme_prime.product_extra_fields</field>
        <field name="arch" type="xml">
            <xpath expr="//div" position="replace">
                <t t-if="website.id == 4">
                    <div class="tp_extra_fields o_not_editable">
                        <!-- Extra Fields -->
                        <t t-if="any([product[field.name] or product_variant[field.name] for field in website.shop_extra_field_ids])">
                            <div t-foreach="website.shop_extra_field_ids" t-as="field"
                                 t-if="product[field.name] or product_variant[field.name]" class="row">
                                <div class="col-12 mb-2">
                                    <h6 class="me-1 d-inline-block mb-0">
                                        <t t-out="field.dr_label or field.label"/>
                                        :
                                    </h6>
                                    <t t-if="field.name == 'public_categ_ids'">
                                        <t t-foreach="product.public_categ_ids" t-as="extra_categ">
                                            <t t-if="extra_categ_index != 0">,</t>
                                            <a class="tp-link-body" t-attf-href="/shop/category/#{slug(extra_categ)}"
                                               t-out="extra_categ.name"/>
                                        </t>
                                    </t>
                                    <t t-elif="field.field_id.ttype != 'binary'">
                                        <span t-out="product_variant[field.name]"
                                              t-options="{'widget': field.field_id.ttype}"/>
                                    </t>
                                    <a t-else="" target="_blank" class="tp-link-body"
                                       t-attf-href="/web/content/product.template/#{product.id}/#{field.name}?download=1">
                                        <i class="fa fa-download"/>
                                    </a>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

