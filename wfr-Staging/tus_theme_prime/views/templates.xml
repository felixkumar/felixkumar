    <record id="tus_theme_prime.tp_mobile_bottombar_component" model="ir.ui.view">
        <field name="name">tp_mobile_bottombar_component</field>
        <field name="inherit_id" search="[('key', '=', 'theme_prime.tp_mobile_bottombar_component')]"/>
        <field name="type">qweb</field>
        <field name="priority" eval="35"/>
        <field name="active">True</field>
        <field name="key">tus_theme_prime.tp_mobile_bottombar_component</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('tp-bottom-bar-add-to-cart')]"
                   position="attributes">
                <t t-if="website.id == 4">
                    <attribute name="class" add="d-none" separator=" "/>
                </t>
            </xpath>
        </field>
    </record>

    <record id="tus_theme_prime.cart_sidebar" model="ir.ui.view">
        <field name="name">tp_mobile_bottombar_component</field>
        <field name="inherit_id" search="[('key', '=', 'theme_prime.cart_sidebar')]"/>
        <field name="type">qweb</field>
        <field name="priority" eval="35"/>
        <field name="active">True</field>
        <field name="key">tus_theme_prime.cart_sidebar</field>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('tp-clear-cart')]" position="attributes">
                <t t-if="website.company_id.is_oxford">
                    <attribute name="class" add="d-none" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//i[hasclass('tp-header-icon')]" position="attributes">
                <t t-if="website.company_id.is_oxford">
                    <attribute name="class" add="d-none" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//h5" position="attributes">
                <t t-if="website.company_id.is_oxford">
                    <attribute name="class" add="fs-16" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-cart-sidebar')]/div/div" position="attributes">
                <t t-if="website.company_id.is_oxford">
                    <attribute name="class" add="justify-content-end col-7" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-cart-sidebar')]/div[@t-else='']" position="replace">
                <t t-if="website.company_id.is_oxford">
                    <div t-if="not order or order and not order.website_order_line"
                         class="text-center d-flex align-items-center h-100 justify-content-center">
                        <div>
                            <h5 class="my-4 fs-20">Your cart is empty!</h5>
                            <a class="btn btn-primary btn-lg br-4 fs-14 fw-600 text-uppercase" href="/shop"
                               style="background-color:#475656 !important;letter-spacing:1.68px;">
                                Shop Now
                            </a>
                        </div>
                    </div>
                </t>
            </xpath>
            <xpath expr="//button[hasclass('btn-close')]" position="attributes">
                <t t-if="website.company_id.is_oxford">
                    <attribute name="class" add="col-5 custom-btn-close" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-scrollable-y')]" position="attributes">
                <t t-if="website.company_id.is_oxford">
                    <attribute name="class" remove="bg-200 p-3" separator=" "/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-hook-total')]" position="replace">
                <t t-if="website.company_id.is_oxford">
                    <div class="tp-hook-total border-top">
                        <t t-set="suggested_product" t-value="order._cart_accessories()"/>
                        <div t-if="suggested_product" class="col-12 p-3" style="background-color:#F8F7F7;">
                            <span class="fw-500 fs-14" style="color:black;">You may also like</span>
                            <t t-set="product" t-value="suggested_product[0]"/>
                            <div class="d-flex flex-row justify-content-between mt-2">
                                <div class="flex-shrink-0">
                                    <span t-field="product.image_128"
                                          t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'border', 'style': 'height:100px;width:100px;border-radius:4px;'}"/>
                                </div>
                                <div class="d-flex flex-column justify-content-between flex-grow-1 ms-3">
                                    <div class="d-flex flex-row justify-content-between">
                                        <div>
                                            <h6>
                                                <a class="tp-link-dark fs-16" t-att-href="product.website_url"
                                                   t-out="product.web_product_title"/>
                                            </h6>
                                            <span class="custom-text-muted fw-500 fs-12"
                                                  t-field="product.website_product_description"/>
                                        </div>
                                        <div class="text-end">
                                            <t t-set="combination"
                                               t-value="product.product_template_attribute_value_ids"/>
                                            <t t-set="combination_info"
                                               t-value="product.product_tmpl_id._get_combination_info(combination, pricelist=order.pricelist_id, add_qty=1)"/>
                                            <div class="d-inline-block float-end ">
                                                <h6 class="css_editable_mode_hidden">
                                                    <span class="oe_price fs-14" style="white-space: nowrap;"
                                                          t-esc="combination_info['price']"
                                                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>

                                                </h6>
                                            </div>
                                            <div class="fs-12">
                                                <span t-attf-class="custom-text-muted oe_default_price fs-12 {{'' if combination_info['has_discounted_price'] and not combination_info['compare_list_price'] else 'd-none'}}"
                                                      style="text-decoration: line-through; white-space: nowrap;"
                                                      t-esc="combination_info['list_price']"
                                                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                                                      itemprop="listPrice"
                                                />
                                                <t t-if="is_view_active('website_sale.tax_indication')"
                                                   t-call="website_sale.tax_indication"/>
                                                <del t-if="combination_info['compare_list_price'] and (combination_info['compare_list_price'] &gt; combination_info['price'])">
                                                    <bdi dir="inherit">
                                                        <span t-esc="combination_info['compare_list_price']"
                                                              groups="website_sale.group_product_price_comparison"
                                                              t-options='{
                           "widget": "monetary",
                           "display_currency": website.currency_id,
                       }'/>
                                                    </bdi>
                                                </del>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-3 fw-700" style="font-size: 14px;">
                                        <input class="js_quantity" name="product_id" t-att-data-product-id="product.id"
                                               type="hidden"/>

                                        <button t-if="product._website_show_quick_add()"
                                                role="button"
                                                class="btn d-flex align-items-center justify-content-center p-0 js_add_suggested_products fw-bold text-uppercase w-100"
                                                style="background-color:#91493C; color:white;height:36px;border-radius:4px;letter-spacing: 1.68px;">
                                            Add
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="row mx-0 pb-3 border-top">
                            <div class="col-12 pt-3">
                                <div class="d-flex justify-content-between fw-500" style="font-size:20px;">
                                    <span>Subtotal</span>
                                    <div>
                                        <span t-field="order.amount_total" class="monetary_field"
                                              t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                        <spna t-field="order.pricelist_id.currency_id.name"/>
                                    </div>
                                </div>
                                <t t-set="redirect_to_sign_in"
                                   t-value="website.account_on_checkout == 'mandatory' and website.is_public_user()"/>
                                <t t-set="redirect_url"
                                   t-value="'/web/login?redirect=/shop/checkout' if redirect_to_sign_in else '/shop/checkout?express=1'"/>
                                <a role="button" t-if="order and order.website_order_line"
                                   class="btn btn-primary d-flex w-100 mt-3 fw-bold text-uppercase align-items-center justify-content-center"
                                   t-attf-href="{{redirect_url}}"
                                   style="height: 56px;border-radius: 4px;background: #475656;color:white;font-size: 16px;letter-spacing: 1.92px;">
                                    <t t-if="redirect_to_sign_in">
                                        <span>Sign In</span>
                                    </t>
                                    <t t-else="">
                                        <span>Proceed to Checkout</span>
                                    </t>
                                </a>
                                <!--                            <a class="btn btn-primary btn-lg shadow d-flex align-items-center justify-content-between tp-proceed-btn"-->
                                <!--                               href="/shop/cart">-->
                                <!--                                <div class="d-flex flex-column align-items-start">-->
                                <!--                                    <span class="tp-total-cart-items">-->
                                <!--                                        <t t-esc="order.cart_quantity"/>-->
                                <!--                                        items-->
                                <!--                                    </span>-->
                                <!--                                    <span t-field="order.amount_total" class="tp-total-amount fw-bold"-->
                                <!--                                          style="white-space: nowrap;"-->
                                <!--                                          t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>-->
                                <!--                                </div>-->
                                <!--                                <small>Proceed-->
                                <!--                                    <i class="fa fa-angle-right ms-1"/>-->
                                <!--                                </small>-->
                                <!--                            </a>-->
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('tp-product-card')]" position="replace">
                <t t-if="website.company_id.is_oxford">
                    <div class="d-flex p-3 position-relative tp-product-card border-bottom"
                         style="border-radius:0 !important;">
                        <div class="flex-shrink-0">
                            <span t-if="line._is_not_sellable_line() and line.product_id.image_128">
                                <img t-att-src="image_data_uri(line.product_id.image_128)"
                                     class="img br-4" height="100" width="100" t-att-alt="line.name_short"/>
                            </span>
                            <span t-else="" t-field="line.product_id.image_128"
                                  t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'border', 'style': 'height:100px;width:100px;border-radius:4px;'}"/>
                        </div>

                        <div class="d-flex flex-column justify-content-between flex-grow-1 ms-3">

                            <div class="d-flex flex-row justify-content-between">
                                <div>
                                    <h6>
                                        <a class="tp-link-dark fs-20" t-att-href="line.product_id.website_url"
                                           t-out="line.product_id.web_product_title"/>
                                    </h6>
                                    <span class="custom-text-muted fw-500 fs-14"
                                          t-field="line.product_id.website_product_description"/>
                                </div>
                                <div class="text-end">
                                    <div class="d-inline-block float-end text-end">
                                        <t groups="account.group_show_line_subtotals_tax_excluded">
                                            <h6 t-field="line.price_reduce_taxexcl" class="text-primary fs-16"
                                                style="white-space: nowrap;color: #282828 !important;"
                                                t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        </t>
                                        <t groups="account.group_show_line_subtotals_tax_included">
                                            <h6 t-field="line.price_reduce_taxinc" class="text-primary fs-16"
                                                style="white-space: nowrap; color: #282828 !important;"
                                                t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        </t>
                                    </div>
                                    <div>
                                        <span t-if="line.discount"
                                              class="custom-text-muted fw-normal text-decoration-line-through fs-14 fw-normal"
                                              t-field="line.price_unit"
                                              t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-row justify-content-between mt-3">
                                <div class="css_quantity oxf_css_quantity br-4 input-group input-group-sm p-0">
                                    <t t-if="not line._is_not_sellable_line()">
                                        <a href="#"
                                           class="btn btn-link js_add_cart_json d-inline-block fw-normal d-flex align-items-center justify-content-center p-0"
                                           aria-label="Remove one" title="Remove one"
                                           style="width:20px;font-size:14px;">
                                            <i class="fa fa-minus"/>
                                        </a>
                                        <input type="text"
                                               class="js_quantity form-control quantity d-flex align-items-center justify-content-center h-100 p-0 fs-12"
                                               t-att-data-line-id="line.id" t-att-data-product-id="line.product_id.id"
                                               t-att-value="int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty"
                                               style="background-color:#EAECEC;opacity:1;color:#282828;width:20px;padding-block:0 !important;padding-inline:0 !important;"/>
                                        <a href="#"
                                           class="btn btn-link js_add_cart_json d-inline-block fw-normal d-flex align-items-center justify-content-center p-0"
                                           aria-label="Add one" title="Add one" style="width:20px;font-size:14px;">
                                            <i class="fa fa-plus"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted w-100" t-out="int(line.product_uom_qty)"/>
                                        <input type="hidden" class="js_quantity form-control quantity"
                                               t-att-data-line-id="line.id" t-att-data-product-id="line.product_id.id"
                                               t-att-value="line.product_uom_qty"/>
                                    </t>
                                </div>
                                <div class="align-self-end">
                                    <a href="#"
                                       class="tp-remove-line tp-icon-center-1 custom-text-muted translate-middle"
                                       title="Remove from Cart">
                                        <i class="fa fa-trash-o" style="font-size:16px !important;"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

</odoo>
