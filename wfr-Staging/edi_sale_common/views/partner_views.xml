<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_res_partner_form_inherit" model="ir.ui.view">
        <field name="name">edi.view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='edi_config']" position="inside">
                    <field name="edi_price_in_cases"/>
                    <field name="edi_contact_type_code"/>
                    <field name="edi_location_code_qualifier"/>
                    <field name="edi_address_location_number"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
