<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduler for Pallet Rate Calculations -->
        <record id="ir_cron_warehouse_stock_inventory" model="ir.cron">
            <field name="name">Generate Warehouse Stock Report</field>
            <field name="model_id" ref="model_warehouse_stock_inventory"/>
            <field name="state">code</field>
            <field name="code">model._generate_warehouse_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

        <record id="ir_cron_warehouse_stock_inventory_all" model="ir.cron">
            <field name="name">Update Warehouse Stock Report</field>
            <field name="model_id" ref="model_warehouse_stock_inventory"/>
            <field name="state">code</field>
            <field name="code">model._update_warehouse_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
        </record>

        <record model="ir.rule" id="warehouse_inventory_report_daily_rule">
            <field name="name">Hide Warehouse Daily Report (Show from December)</field>
            <field name="model_id" ref="warehouse_inventory_report.model_warehouse_stock_inventory"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('report_date', '>=', '2024-12-01')]</field>
        </record>

        <record model="ir.rule" id="warehouse_inventory_report_monthly_rule">
            <field name="name">Hide Warehouse Monthly Report (Show from December)</field>
            <field name="model_id" ref="warehouse_inventory_report.model_stock_fee_billing"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('stock_fee_date', '>=', '2024-12-01')]</field>
        </record>

    </data>
</odoo>