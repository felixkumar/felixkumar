<?xml version="1.0"?>
<odoo>

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.appointments</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" 
                        type="action" 
                        name="%(business_appointment.business_appointment_action_tree_main)d"
                        groups="business_appointment.group_ba_user"
                        icon="fa-calendar-check-o"
                        context="{'default_partner_id': id, 'search_default_partner_id': id, 'search_default_planned_appointments': 1}"
                >
                    <field string="Appointments" name="appointments_len" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
