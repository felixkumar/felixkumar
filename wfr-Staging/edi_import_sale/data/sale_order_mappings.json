{
    "config": [
        {
            "path": "Orders/Order",
            "model": "sale.order"
        },
        {
            "path": "Orders/Order/Header/OrderHeader/TradingPartnerId",
            "field": "partner_id",
            "search_field": "trading_partnerid",
            "is_custom_method": true,
            "use_for_creation": true,
            "is_search_field": true,
            "can_be_used_in_creation": true,
            "custom_method_name": "create_partner_so",
            "default": "0"
        },
        {
            "path": "Orders/Order/Header/OrderHeader/PurchaseOrderNumber",
            "custom_method": "process_po_number",
            "custom_method_returns_dict": true,
            "skip": true,
            "skip_overrides": [
                {
                    "path": "../TsetPurposeCode",
                    "comparison": "!=",
                    "value": "00"
                },
                {
                    "path": "../PrimaryPOTypeCode",
                    "comparison": "!=",
                    "value": "SA"
                },
                {
                    "path": "../PrimaryPOTypeCode",
                    "comparison": "!=",
                    "value": "NE"
                }
            ]
        },
        {
            "path": "Orders/Order/Header/OrderHeader/TsetPurposeCode",
            "field": "edi_tset_purpose_code"
        },
        {
            "path": "Orders/Order/Header/OrderHeader/PrimaryPOTypeCode",
            "field": "edi_primary_PO_type_code",
            "allowed_values": ["SA", "NE", "PR", "RO", "CF"],
            "default": "NA"
        },
        {
            "path": "Orders/Order/Header/OrderHeader/PrimaryPOTypeDescription",
            "field": "edi_primary_PO_type_description"
        },
