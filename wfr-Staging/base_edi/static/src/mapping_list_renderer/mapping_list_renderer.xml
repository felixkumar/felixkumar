<templates>
    <t t-name="base_edi.MappingListRenderer.Rows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary" owl="1">
        <xpath expr="//t[@t-foreach='list.records']" position="attributes">
            <attribute name="t-foreach">rowState.recordsToDisplay</attribute>
        </xpath>
    </t>

    <t t-name="base_edi.MappingListRenderer.RecordRow" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="primary" owl="1">
        <xpath expr="//td[@t-att-name='column.name']" position="replace">
            <t t-log="'In base_edi.MappingListRenderer.RecordRow'"/>
            <t t-if="column.options.expandable">
                <td class="o_data_cell cursor-pointer"
                    t-att-class="getCellClass(column, record)"
                    t-att-name="column.name"
                    t-att-colspan="column.colspan"
                    t-att-data-tooltip="!isInvisible ? getCellTitle(column, record) : false"
                    data-tooltip-delay="1000"
                    tabindex="-1">
                    <t t-if="!isInvisible">
                        <span t-if="column.options.expandable and record.data.depth >= 1">
                            <t t-foreach="[...Array(record.data.depth).keys()]" t-as="depth" t-key="depth">
                                <span class="fa fa-fw"/>
                            </t>
                        </span>
                        <span t-if="column.options.expandable and expandedRecords.has(record.data.id)" class="fa fa-fw me-1 fa-caret-down" t-on-click="() => this.collapseChildren(record)"/>
                        <span t-if="column.options.expandable and !expandedRecords.has(record.data.id) and record.data.has_children" class="fa fa-fw me-1 fa-caret-right" t-on-click="() => this.expandChildren(record)"/>
                        <span t-on-keydown.synthetic="(ev) => this.onCellKeydown(ev, group, record)" t-on-click="(ev) => this.onCellClicked(record, column, ev)">
                            <t t-if="canUseFormatter(column, record)" t-out="getFormattedValue(column, record)"/>
                            <Field t-else="" name="column.name" record="record" type="column.widget" class="getFieldClass(column)" fieldInfo="props.archInfo.fieldNodes[column.name]" setDirty="(isDirty) => this.setDirty(isDirty)"/>
                        </span>
                    </t>
                </td>
            </t>
            <t t-else="">
                <td t-on-keydown.synthetic="(ev) => this.onCellKeydown(ev, group, record)"
                    class="o_data_cell cursor-pointer"
                    t-att-class="getCellClass(column, record)"
                    t-att-name="column.name"
                    t-att-colspan="column.colspan"
                    t-att-data-tooltip="!isInvisible ? getCellTitle(column, record) : false"
                    data-tooltip-delay="1000"
                    t-on-click="(ev) => this.onCellClicked(record, column, ev)" tabindex="-1">
                    <t t-if="!isInvisible">
                        <t t-if="canUseFormatter(column, record)" t-out="getFormattedValue(column, record)"/>
                        <Field t-else="" name="column.name" record="record" type="column.widget" class="getFieldClass(column)" fieldInfo="props.archInfo.fieldNodes[column.name]" setDirty="(isDirty) => this.setDirty(isDirty)"/>
                    </t>
                </td>
            </t>
        </xpath>
    </t>
</templates>