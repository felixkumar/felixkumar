<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="identical_sku_product_template_form_inherit" model="ir.ui.view">
            <field name="name">identical.sku.product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales']" position="after">
                    <page name="identical_sku_page" string="SKU Mapping"
                          groups="product_identical_sku.group_sku_mapping_manager">
                        <field name="identical_sku_ids" context="{'default_product_id': active_id}">
                            <tree editable="1">
                                <field name="name"/>
                                <field name="marketplace_id"/>
                                <field name="is_third_party"/>
                                <field name="is_prime"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>