                                    <div style="width:200px; float:left;white-space: nowrap; padding: 4px 18px 3px 8px;margin-top:5px;margin-bottom:30px">
                                        <div style="float:left;">Sub Total</div>
                                        <div type="text" style="text-align:right;width:95px;float:right;">
                                            <span t-field="o.amount_untaxed"
                                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </div>
                                    </div>
                                    <div style="width:200px; float:left;padding: 2px 18px 3px 8px;margin-top:-15px;margin-bottom:45px;">
                                        <div style=" float:left;">Taxes</div>
                                        <div type="text" style="text-align:right;width:95px;float:right;">
                                            <span t-field="o.amount_tax"
                                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </div>
                                    </div>
