                    <!--<div class="last-page">-->
                    <table class="table mt32" width="100%" style="font-size:12px;border: 1px solid black;"
                           cellspacing="0">
                        <tr class="border-sub-row-note border-heading-right-main border-heading-left-main"
                            style="line-height: normal;border: 1px solid black;">
                            <td width="50%" colspan="6"
                                style="padding: 10px 0px 0px 10px !important;vertical-align: top;word-wrap: break-word;">
                                <t t-if="len(', '.join((o.freight_id.customer_po).split(' | '))) &lt;= 576">
                                    <div style="word-wrap: break-word;">
                                        <span>
                                            <b>NOTES:</b>
                                        </span>
                                        <br/>
                                        <t t-if="show_po_in_notes">
                                            <t t-esc="', '.join((o.freight_id.customer_po).split(' | '))"/>
                                        </t>
                                        <span>
                                            <t t-esc="o.narration"/>
                                        </span>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="word-wrap: break-word; font-size:11px;">
                                        <span>
                                            <b>NOTES:</b>
                                        </span>
                                        <br/>
                                        <t t-if="show_po_in_notes">
                                            <t t-esc="', '.join((o.freight_id.customer_po).split(' | '))"/>
                                        </t>
                                        <span>
                                            <t t-esc="o.narration"/>
                                        </span>
                                    </div>
                                </t>

