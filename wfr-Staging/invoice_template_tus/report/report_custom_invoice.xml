<?xml version="1.0" encoding="utf-8"?>
<!--    OBL Invoice    -->
<odoo>
    <data>
        <template id="report_custom_invoice_document">
            <t t-call="web.basic_layout">
                <div class="header">
                    <style>
                        .text_label{
                        width:350px;
                        height:20px !important;
                        background-color: #b8b8b8;
                        font-size:13px;
                        }
                        .text_data{
                        white-space:nowrap;
                        font-size:13px;
                        }
                        .header_text_label{
                        font-size:13px;
                        background-color: #b8b8b8;
                        white-space:nowrap;
                        }
                        .border-heading-row td{
                        background-color: #b8b8b8;
                        font-size:13px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        text-align:center;
                        width:40px !important;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row td{
                        font-size:13px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row-note td{
                        font-size:13px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        width:40px !important;
                        border-right:none !important;
                        }
                        .border-heading-main td{
                        border-right:none;
                        border-left:none;
                        }
                        .border-heading-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-heading-main td:last-child{
                        border-right:1px solid #000 !important;
                        }
                        .border-heading-right-main td:last-child{
                        border-right:1px solid #000 !important;
                        padding-right: 10px !important;
                        }
                        .border-heading-left-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-top-main td{
                        border-top:1px solid #000 !important;
                        }
                        .table th, .table td {
                        padding: 6px;
                        }
                        .display-table th, .display-table td {
                        border:none !important;
                        }
                        .display-table{
                        width:100% !important;
                        border: 1px solid #000 !important;
                        font-size:12px !important;
                        text-align:center;
                        line-height:25px;
                        margin:0 !important;
                        padding:0 !important;
                        border-right:1px solid #000 !important;
                        }
                        .display-table tr{
                        width:100% !important;
                        }
                        .display-table td:nth-child(1){
                        width:80px !important;
                        }
                        .display-table td:nth-child(2){
                        width:80px !important;
                        }
                        .display-table td:nth-child(3){
                        width:280px !important;
                        }
                        .display-table td:nth-child(4){
                        width:80px !important;
                        }
                        .display-table td:nth-child(5){
                        width:80px !important;
                        }
                        .display-table td:nth-child(6){
                        width:80px !important;
                        }
                        .display-table td:nth-child(7){
                        width:80px !important;
                        }
                        .display-table td:nth-child(8){
                        width:80px !important;
                        }
                        .page_border {
                        border-left: 1px solid #000;
                        border-right: 1px solid #000;
                        <!--border-bottom: 1px solid #000;-->
                        margin-top: 485px !important;
                        position: fixed;
                        z-index: 9999;
                        height: 139mm !important;
                        left: 15px;
                        right: 15px;
                        top: 0;

                        }
                    </style>
                    <div class="page_border"/>
                    <t t-set="line_length" t-value="1"/>
                    <t t-set="item_line_length" t-value="0"/>
                    <t t-set="partner_id"
                       t-value="o.freight_id.partner_id and o.freight_id.partner_id[0] or o.partner_id"/>
                    <t t-set="po_id"
                       t-value="o.invoice_line_ids and o.invoice_line_ids[0].sale_line_ids and o.invoice_line_ids[0].sale_line_ids[0].order_id.purchase_order_id or False"/>

                    <t t-if="o.freight_id.customer_po and len((o.freight_id.customer_po).split('|')) > 1">
                        <t t-set="customer_po" t-value="'Multiple'"/>
                        <t t-set="show_po_in_notes" t-value="True"/>
                    </t>
                    <t t-else="">
                        <t t-set="customer_po" t-value="o.freight_id.customer_po"/>
                        <t t-set="show_po_in_notes" t-value="False"/>
                    </t>

                    <table class="table mt32" style="float:left;width:100%;font-size:12px !important;" cellspacing="0">
                        <tbody style="line-height:normal;border: 1px solid white;">
                            <td style="width: 80%; padding-left: 15px;border: 1px solid white;">
                                <img src="invoice_template_tus/static/src/img/warefor_logo.png"
                                     style="height: 45px;width: 205px;" alt="Logo"/>
                                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                                <br/>
                                <b t-esc="o.company_id.partner_id.name"/>
                                <br/>
                                <t t-esc="o.company_id.partner_id.street"/>
                                <br/>
                                <t t-esc="o.company_id.partner_id.city"/>,
                                <t t-esc="o.company_id.partner_id.state_id.code"/>
                                <t t-esc="o.company_id.partner_id.zip"/>
                                <br/>
                                <t t-esc="o.company_id.partner_id.phone"/>
                            </td>
                            <td style="width: 30%;border-top: 1px solid white; padding-left:50px">
                                <div style="width:300px; background-color: #b8b8b8; font-size:15px;border-top: 1px solid white;">
                                    <p style="text-align: center;">
                                        <b>INVOICE</b>
                                    </p>
                                </div>
                                <span>Invoice #:</span>
                                <span style="padding-left: 63px;">
                                    <b t-esc="o.name"/>
                                    - Page
                                    <span class="page"/>
                                    of
                                    <span class="topage"/>
                                </span>
                                <br/>
                                <br/>
                                <span>Invoice Date:</span>
                                <span style="padding-left: 45px;">
                                    <b t-esc="o.invoice_date and o.invoice_date.strftime('%m/%d/%y')"/>
                                </span>
                                <br/>
                                <br/>
                                <span>Vendor Number:</span>
                                <span style="padding-left: 27px;">
                                    <b t-esc="o.freight_id.partner_id.warefor_vendor_number or ''"/>
                                </span>
                            </td>
                        </tbody>
                        <tbody style="line-height:normal;border: 1px solid white;">
                            <td style="padding:2px;border: 1px solid white;">
                                <div class="text_label" style="padding-left: 12px; padding-top: 3px;!important">
                                    <b>BILL TO</b>
                                </div>
                                <div style="padding-left: 15px;">
                                    <br/>
                                    <b>
                                        <t t-esc="partner_id.name or ''"/>
                                    </b>
                                    <t t-if="o.freight_id.partner_id">
                                        <br/>
                                        <t t-esc="o.freight_id.partner_id.street"/>
                                        <t t-if="o.freight_id.partner_id.street2">,
                                            <t t-esc="o.freight_id.partner_id.street2"/>
                                        </t>
                                        <br/>
                                        <t t-esc="o.freight_id.partner_id.city"/>
                                        <t t-if="o.freight_id.partner_id.city">,</t>
                                        <t t-esc="o.freight_id.partner_id.state_id.code"/>
                                        <t t-esc="o.freight_id.partner_id.zip"/>
                                        <br/>
                                        <t t-esc="o.freight_id.partner_id.country_id.name"/>
                                        <br/>
                                    </t>
                                    <t t-else="">
                                        <br/>
                                        <t t-esc="o.partner_id.street"/>
                                        <t t-if="o.partner_id.street2">,
                                            <t t-esc="o.partner_id.street2"/>
                                        </t>
                                        <br/>
                                        <t t-esc="o.partner_id.city"/>
                                        <t t-if="o.partner_id.city">,</t>
                                        <t t-esc="o.partner_id.state_id.code"/>
                                        <t t-esc="o.partner_id.zip"/>
                                        <br/>
                                        <t t-esc="o.partner_id.country_id.name"/>
                                        <br/>
                                    </t>
                                </div>
                            </td>
                            <td style="padding:1px;border: 1px solid white;">
                                <div class="text_label" style="padding-left: 15px; padding-top: 3px !important;">
                                    <b>SHIP TO</b>
                                </div>
                                <div style="padding-left: 15px;white-space: nowrap;">
                                    <t t-if="o.freight_id.outbound_partner_id">
                                        <br/>
                                        <b>
                                            <t t-esc="o.freight_id.outbound_partner_id.name or ''"/>
                                        </b>
                                        <br/>
                                        <t t-esc="o.freight_id.outbound_partner_id.street"/>
                                        <t t-if="o.freight_id.outbound_partner_id.street2">,
                                            <br/>
                                            <t t-esc="o.freight_id.outbound_partner_id.street2"/>
                                        </t>
                                        <br/>
                                        <t t-esc="o.freight_id.outbound_partner_id.city"/>
                                        <t t-if="o.freight_id.outbound_partner_id.city">,</t>
                                        <t t-esc="o.freight_id.outbound_partner_id.state_id.code"/>
                                        <t t-esc="o.freight_id.outbound_partner_id.zip"/>
                                        <br/>
                                        <t t-esc="o.freight_id.outbound_partner_id.country_id.name"/>
                                        <br/>
                                    </t>
                                    <t t-else="">
                                        <br/>
                                        <b>
                                            <t t-esc="o.partner_shipping_id.name or ''"/>
                                        </b>
                                        <br/>
                                        <t t-esc="o.partner_shipping_id.street"/>
                                        <t t-if="o.partner_shipping_id.street2">,
                                            <t t-esc="o.partner_shipping_id.street2"/>
                                        </t>
                                        <br/>
                                        <t t-esc="o.partner_shipping_id.city"/>
                                        <t t-if="o.partner_shipping_id.city">,</t>
                                        <t t-esc="o.partner_shipping_id.state_id.code"/>
                                        <t t-esc="o.partner_shipping_id.zip"/>
                                        <br/>
                                        <t t-esc="o.partner_shipping_id.country_id.name"/>
                                        <br/>
                                    </t>
                                </div>
                            </td>
                        </tbody>
                    </table>
                    <table class="table mt32"
                           style="width:100%; font-size:12px !important; margin-bottom: 15px !important;"
                           cellspacing="0">
                        <tr class="border-heading-row border-heading-right-main border-heading-left-main">
                            <td width="25%" class="header_text_label">
                                Customer Account #
                            </td>
                            <td width="25%" class="header_text_label">
                                Customer Reference #
                            </td>
                            <td width="25%" class="header_text_label">
                                Payment Terms
                            </td>
                            <td width="25%" class="header_text_label">
                                Due Date
                            </td>
                        </tr>
                        <tr class="border-sub-row border-heading-right-main border-heading-left-main">
                            <td width="25%" class="text_data">
                                <t t-esc="o.partner_id.id"/>
                            </td>
                            <td width="25%" class="text_data">
                                <t t-esc="o.freight_id.reference"/>
                            </td>
                            <td width="25%" class="text_data">
                                <t t-esc="o.invoice_payment_term_id.name or ''"/>
                            </td>
                            <td width="25%" class="text_data">
                                <t t-esc="o.invoice_date_due and o.invoice_date_due.strftime('%m/%d/%y')"/>
                            </td>
                        </tr>
                        <tr class="border-heading-row border-heading-right-main border-heading-left-main">
                            <td width="25%" class="header_text_label">
                                Customer PO #
                            </td>
                            <td width="25%" class="header_text_label">
                                Bill of Lading #
                            </td>
                            <td width="25%" class="header_text_label">
                                Carrier Name
                            </td>
                            <td width="25%" class="header_text_label">
                                Ship Date
                            </td>
                        </tr>
                        <tr class="border-sub-row border-heading-right-main border-heading-left-main">
                            <td width="25%" class="text_data">
                                <t t-esc="customer_po"/>
                            </td>
                            <td width="25%" class="text_data">
                                <t t-esc="o.freight_id.bol_number"/>
                            </td>
                            <td width="25%" class="text_data">
                                <t t-esc="o.freight_id.carrier_flight.name"/>
                            </td>
                            <td width="25%" class="text_data">
                                <t t-esc="o.freight_id.loading_end_date and o.freight_id.loading_end_date.strftime('%m/%d/%y')"/>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="page_border" style="padding-top: 0px !important; padding-left: 0px !important;">
                    <style>
                        .text_label{
                        width:350px;
                        height:20px !important;
                        background-color: #b8b8b8;
                        font-size:12px;
                        }
                        .text_data{
                        height:15px !important;
                        font-size:12px;
                        }
                        .header_text_label{
                        font-size:12px;
                        background-color: #b8b8b8;
                        }
                        .border-heading-row td{
                        background-color: #b8b8b8;
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        width:40px !important;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row td{
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        width:40px !important;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row-note td{
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        width:40px !important;
                        border-right:none !important;
                        }
                        .border-heading-main td{
                        border-right:none;
                        border-left:none;
                        }
                        .border-heading-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-heading-main td:last-child{
                        border-right:1px solid #000 !important;
                        }
                        .border-heading-right-main td:last-child{
                        border-right:1px solid #000 !important;
                        padding-right: 10px !important;
                        }
                        .border-heading-left-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-top-main td{
                        border-top:1px solid #000 !important;
                        }
                        .table th, .table td {
                        padding: 3px;
                        }
                        .display-table th, .display-table td {
                        border:none !important;
                        }
                        .display-table{
                        width:100% !important;
                        border: 1px solid #000 !important;
                        font-size:12px !important;
                        text-align:center;
                        line-height:25px;
                        margin:0 !important;
                        padding:0 !important;

                        border-right:1px solid #000 !important;
                        }
                        .display-table tr{
                        width:100% !important;
                        }
                        .display-table td:nth-child(1){
                        width:80px !important;
                        }
                        .display-table td:nth-child(2){
                        width:80px !important;
                        }
                        .display-table td:nth-child(3){
                        width:280px !important;
                        }
                        .display-table td:nth-child(4){
                        width:80px !important;
                        }
                        .display-table td:nth-child(5){
                        width:80px !important;
                        }
                        .display-table td:nth-child(6){
                        width:80px !important;
                        }
                        .display-table td:nth-child(7){
                        width:80px !important;
                        }
                        .display-table td:nth-child(8){
                        width:80px !important;
                        }
                    </style>


                    <table class="table mt32"
                           style="width:100%; font-size:12px !important;margin-bottom: 30px !important;margin-top:5px;"
                           cellspacing="0">
                        <tr class="border-heading-row border-heading-right-main border-heading-left-main">
                            <td style="width:15% !important" class="header_text_label">
                                Item #
                            </td>
                            <td style="width:35% !important" class="header_text_label">
                                Item Description
                            </td>
                            <td style="width:10% !important" class="header_text_label">
                                Total Qty
                            </td>
                            <td style="width:10% !important" class="header_text_label">
                                Lot/Serial #
                            </td>
                            <td style="width:10% !important" class="header_text_label">
                                Pallet Qty
                            </td>
                            <td style="width:10% !important" class="header_text_label">
                                Cost
                            </td>
                            <td style="width:10% !important" class="header_text_label">
                                Total Cost
                            </td>
                        </tr>

                        <t t-if="o.freight_id.freight_order_line_ids">
                            <tr t-foreach="o.freight_id.freight_order_line_ids" t-as="freight_order_line_id"
                                class="text_data border-sub-row border-heading-right-main border-heading-left-main">
                                <td style="width:15% !important;" class="text_data">
                                    <t t-esc="freight_order_line_id.goods.default_code"/>
                                </td>
                                <td style="width:35% !important;text-align:left;padding-left:10px;" class="text_data">
                                    <t t-esc="freight_order_line_id.goods.name"/>
                                    <t t-if="freight_order_line_id.goods.name and len(freight_order_line_id.goods.name) &gt; 45">
                                        <t t-set="item_line_length"
                                           t-value="item_line_length + ceil(len(freight_order_line_id.goods.name) / 42)"/>
                                    </t>
                                    <t t-elif="freight_order_line_id.goods.name">
                                        <t t-set="item_line_length" t-value="item_line_length + 1"/>
                                    </t>
                                </td>
                                <td style="width:10% !important" class="text_data">
                                    <t t-esc="'{:,d}'.format(freight_order_line_id.total_quantity and int(freight_order_line_id.total_quantity or 0))"/>
                                </td>
                                <td style="width:10% !important" class="text_data">
                                    <t t-esc="freight_order_line_id.lot_id.name"/>
                                </td>
                                <td style="width:10% !important" class="text_data">
                                    <t t-esc="ceil(freight_order_line_id.required_pallet or 0)"/>
                                    <!--                                <t t-esc="'{:,d}'.format(freight_order_line_id.required_pallet and int(freight_order_line_id.required_pallet) or 0)"/>-->
                                </td>
                                <td style="width:10% !important" class="text_data">
                                    <t t-esc="freight_order_line_id.base_cost"
                                       t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                                <td style="width:10% !important;text-align:right;" class="text_data">
                                    <t t-esc="freight_order_line_id.value"
                                       t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr class="text_data border-sub-row border-heading-right-main border-heading-left-main">
                                <td style="height:15px;" colspan="7"/>
                            </tr>
                        </t>
                    </table>
                    <t t-set="line_item_length" t-value="len(o.freight_id.freight_order_line_ids)"/>
                    <t t-if="line_item_length &gt; 3">
                        <div class="pagebreak" style="width: 150%; page-break-inside: avoid;"/>
                    </t>

                    <t t-set="min_height_t1"
                       t-value="560 - ((item_line_length + len(o.invoice_line_ids))  * 20) - (o.company_banking_info_want and 180 or 0)"/>
                    <!--                    <table class="display-table table table-sm o_main_table table-borderless mt-4" style="display:block;min-height: 250px !important;border-top: hidden !important;margin-top:30px !important;margin-bottom:30px;">-->
                    <table class="display-table table table-sm o_main_table table-borderless mt-4"
                           style="display:block;border-top: none !important;border-bottom: none !important;margin-top:15px !important;">
                        <thead style="background-color:#b8b8b8 !important;color:#212529 !important;margin-bottom: 15px !important;border-top: 1px solid black !important;border-bottom: 1px solid black !important;">
                            <td class="text_data">Line #</td>
                            <td class="text_data">Item #</td>
                            <td class="text_data" style="text-align: left; padding-left:25px;">Description</td>
                            <td class="text_data" style="text-align: right;padding-right:15px;">Quantity</td>
                            <td class="text_data">UOM</td>
                            <td class="text_data" style="text-align: right;">Unit Price</td>
                            <td class="text_data">Taxes</td>
                            <td class="text_data">Total Price</td>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.invoice_line_ids" t-as="invoice_line"
                                style="border-bottom:hidden !important;">
                                <td class="text_data">
                                    <span t-esc="line_length"/>
                                    <t t-set="line_length" t-value="line_length + 1"/>
                                </td>
                                <td class="text_data">
                                    <span t-esc="invoice_line.product_id.default_code"/>
                                </td>
                                <td class="text_data" style="text-align: left;padding-left:25px;">
                                    <span t-esc="invoice_line.name"/>
                                </td>
                                <td class="text_data" style="text-align: right;padding-right:15px;">
                                    <span t-esc="'{:,.2f}'.format(invoice_line.quantity or 0)"/>
                                </td>
                                <td class="text_data">
                                    <span t-esc="invoice_line.product_uom_id.name"/>
                                </td>
                                <td class="text_data" style="text-align: right;">
                                    <span t-field="invoice_line.price_unit"
                                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                                <td class="text_data">
                                    <t t-if="invoice_line.tax_ids">
                                        <t t-esc="', '.join(invoice_line.tax_ids.mapped('name'))"/>
                                    </t>
                                    <t t-else="">N/A</t>
                                </td>
                                <td class="text_data" style="text-align: right;padding-right:8px !important;">
                                    <span t-field="invoice_line.price_subtotal"
                                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Add space between tables -->

                    <table style="border: 1px solid black; width: 100%; page-break-inside: avoid;" class="no-page-break">
                        <t t-if="o.company_banking_info_want">
                            <tr>
                                <td style="font-size: 12px !important; white-space: nowrap; border: none; border-left:none !important;">
                                    <div style="margin-left: 8px !important; white-space: nowrap; line-height: 25px; margin-top:15px; border-left:none !important;" t-raw="o.company_banking_info"/>
                                </td>
                            </tr>
                        </t>
                    </table>

                </div>


                <div class="footer">
                    <style>
                        .border-sub-row td{
                        font-size:12px;
