                    </table>
                    <!--</div>-->
                </div>
            </t>
        </template>

        <template id="report_custom_customer_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang"
                       t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-if="o.move_type in ('out_refund', 'in_refund')">
                        <t t-if="o.freight_id.is_outbound">
                            <t t-call="invoice_template_tus.report_custom_credit_memo_obl"/>
                        </t>
                        <t t-elif="o.freight_id">
                            <t t-call="invoice_template_tus.report_custom_credit_memo_ibl"/>
                        </t>
                        <t t-else="">
                            <t t-call="invoice_template_tus.report_custom_credit_memo"/>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-if="o.freight_id.is_outbound">
                            <t t-call="invoice_template_tus.report_custom_invoice_document"/>
                        </t>
                        <t t-elif="o.freight_id">
                            <t t-call="invoice_template_tus.report_custom_invoice_document_ibl"/>
                        </t>
                        <t t-else="">
                            <t t-call="invoice_template_tus.report_custom_invoice_main"/>
                        </t>
                    </t>
                </t>
            </t>
        </template>

    </data>
