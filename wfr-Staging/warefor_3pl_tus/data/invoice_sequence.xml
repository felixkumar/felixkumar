<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_custom_invoice" model="ir.sequence">
            <field name="name">Custom Invoice</field>
            <field name="code">custom.invoice.sequence</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"></field>
        </record>

        <record id="seq_account_move" model="ir.sequence">
            <field name="name">Account Move Sequence</field>
            <field name="code">seq.account.move</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"></field>
        </record>

        <record id="sequence_warefor_internal_transfer" model="ir.sequence">
            <field name="name">Custom Internal Transfer</field>
            <field name="code">warefor.internal.transfer</field>
<!--            <field name="prefix">INT/</field>-->
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>