        <record id="mail_template_pallet_batch" model="mail.template">
            <field name="name">Pallet Batch: Send by Email</field>
            <field name="model_id" ref="model_pallet_batch_tus"/>
            <field name="subject">Pallet Batch (Ref ${object.name or 'n/a' })</field>
            <field name="partner_to">${object.company_id.pallet_batch_user_id.partner_id.id}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello ${object.company_id.pallet_batch_user_id.partner_id.name},
                        <br/>
                        <br/>
                        We are glad to inform you that your pallet batch has been done. Which is start from
                        ${object.start_date} to ${object.start_date} with respective costs below:
                        <br/>
                        Import Cost: ${object.import_cost}
                        <br/>
                        Storage Cost: ${object.storage_cost}
                        <br/>
                        Service Cost: ${object.service_cost}
                        <br/>

                        <br/>
                        % if object.invoice_ids:
                        Please find your pallet batch invoice attached for more details.
                        <br/>
                        <br/>
                        % endif
                        Thank you,
                        % if user.signature:
                        <br/>
                        ${user.signature | safe}
                        % endif
                    </p>
                </div>
            </field>
            <!--        <field name="report_template" ref=""/>-->
            <!--        <field name="report_name">${(object.name or '').replace('/','_')}</field>-->
            <field name="lang">${object.company_id.pallet_batch_user_id.partner_id.lang}</field>
            <field name="auto_delete" eval="False"/>
        </record>

