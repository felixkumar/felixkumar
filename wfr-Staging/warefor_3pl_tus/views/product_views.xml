<?xml version="1.0"?>
<odoo>
    <record id="product_product_inventory_view_form_normal_inherit_warefor_3pl" model="ir.ui.view">
        <field name="name">product.product.inventory.view.form.normal.inherit.warefor.3pl</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='%(stock.action_product_replenish)d']" position="attributes">
                <attribute name="groups">!user_warehouse_restriction.user_warehouse_restriction_group_user</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_inventory_view_form_normal_inherit_warefor_3pl" model="ir.ui.view">
        <field name="name">product.template.inventory.view.form.normal.inherit.warefor.3pl</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='%(stock.action_product_replenish)d']" position="attributes">
                <attribute name="groups">!user_warehouse_restriction.user_warehouse_restriction_group_user
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_form_normal_inherit_warefor_3pl" model="ir.ui.view">
        <field name="name">product.template.view.form.normal.inherit.warefor.3pl</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='inventory']/group[@name='inventory']" position="after">
                <group name="container_section" string="Product Information">
                    <group>
                        <field name="product_per_pallet" string="Sellable Units Per Pallet"/>
                        <field name="cartons_per_container"/>
                        <field name="cartons_per_pallet"/>
                        <field name="pallet_stacking"/>
                    </group>
                    <group>
                        <field name="cases_per_carton"/>
                        <field name="units_per_case"/>
                        <field name="warehouse_stacking"/>
                    </group>
                </group>

                <group col="12" name="measurement">
                    <group colspan="3" string="Measurement">
                        <field name="is_packaging_product" invisible="1"/>
                        <field name="product_height"/>
                        <field name="product_width"/>
                        <field name="product_length"/>
                    </group>
<!--                    Pallet Measurements-->
                    <group colspan="3" string="Pallet Measurements">
                        <field name="pallet_height"/>
                        <field name="pallet_width"/>
                        <field name="pallet_length"/>
                    </group>
                    <group colspan="6" string="Image">
                        <field name="product_pallet" widget="image"/>
                        <field name="warehouse_pallet" widget="image"/>
                        <field name="mis_file"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//group[@name='group_lots_and_weight']/div[@name='volume']" position="after">
                <label for="pallet_volume"  attrs="{'invisible':[('product_variant_count', '>', 1), ('is_product_variant', '=', False)]}"/>
                <div class="o_row"  attrs="{'invisible':[('product_variant_count', '>', 1), ('is_product_variant', '=', False)]}">
                    <field name="pallet_volume" class="oe_inline"/>
                    <span><field name="volume_uom_name"/></span>
                </div>
            </xpath>

            <xpath expr="//field[@name='packaging_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_ok']" position="before">
                    <field name="is_fba"/>
                    <label for="is_fba"/>
                    <field name="is_prime"/>
                    <label for="is_prime"/>
            </xpath>
            <xpath expr="//field[@name='packaging_ids']" position="after">
                <group>
                    <group>
                        <field name="packaging_id"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//header/button[@name='action_open_label_layout']" position="attributes">
                <attribute name="groups">!user_warehouse_restriction.user_warehouse_restriction_group_user</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit_warefor" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.warefor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">MFR SKU</attribute>
            </xpath>
        </field>
    </record>

