<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="warefor_internal_transfer_form_view" model="ir.ui.view">
            <field name="name">warefor.internal.transfer.form.view</field>
            <field name="model">warefor.internal.transfer</field>
            <field name="groups_id" eval="[(4, ref('base.group_erp_manager'))]"/>
            <field name="arch" type="xml">
                <form string="Warefor Intrenal Transfer">
                    <header>
                        <field name="internal_transfer_stage_id" widget="statusbar"/>
<!--                        <button name="create_warehouse_internal_transfer" string="Create Transfer" type="object" attrs="{'invisible': [('warefor_internal_transfers_count','!=', 0)]}"-->
<!--                                class="btn-primary"/>-->
                        <button name="action_transfer_cancel" string="Cancel" type="object" attrs="{'invisible': [('internal_transfer_stage_id','=', 'cancel')]}"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" groups="stock.group_stock_user">
                            <button name="button_warefor_internal_transfers" type="object" class="oe_stat_button" attrs="{'invisible': [('warefor_internal_transfers_count','=', 0)]}"
                                    icon="fa-truck" >
                                <field name="warefor_internal_transfers_count" widget="statinfo" string="Internal Transfers" attrs="{'invisible': [('warefor_internal_transfers_count','=', 0)]}"/>
                            </button>
                        </div>
                        <group>
                                <div class="oe_title">
                                    <h1>INTERNAL TRANSFER</h1>
                                    <h2>
                                        <field name="name" nolabel="1" placeholder="e.g. WFL/00001" readonly="1"/>
                                    </h2>
                                </div>
                        </group>
                        <group>
                            <group>
                                <field name="freight_id" invisible="1"/>
                                <field name="active" invisible="1"/>
                                <field name="warehouse_id" required="1"/>
                                <field name="date" readonly="1"/>
                                <field name="picking_ids" invisible="1"/>
<!--                                <field name="status_id"/>-->
                            </group>
                        </group>

                        <field name="internal_transfer_ids" nolabel="1">
                            <tree string="Transfer Inventory" editable="bottom">
                                <field name="sku_id" required="1" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="freight_id" invisible="1"/>
                                <field name="is_validated" invisible="1"/>
                                <field name="is_created" invisible="1"/>
                                <field name="description"/>
                                <field name="warehouse_id" invisible="1"/>
                                <field name="quantity"/>
                                <field name="lot_id"/>
                                <field name="location_id" string="Source Location" domain="[('warehouse_id','=',warehouse_id), ('is_omit_on_source_location', '=', False)]" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="source_location_on_hand_qty"/>
                                <field name="destination_location_id" string="Destination Location" required="1"
                                       domain="[('warehouse_id','=',warehouse_id), ('is_omit_on_source_location', '=', False)]" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="destination_location_on_hand_qty"/>
                                <button name="create_warehouse_internal_transfer_button" attrs="{'invisible': [('is_created','=',True)]}" string="Create Transfer" type="object" class="btn-primary"/>
                                <button name="validate_internal_transfer" string="Validate" attrs="{'invisible': ['|',('is_validated','=',True),('is_created','=',False)]}"
                                            type="object" class="btn-primary"/>
                            </tree>
                        </field>

                    </sheet>
<!--                    <div class="warehouse_chatter_position">-->
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
<!--                    </div>-->
                </form>
            </field>
        </record>

        <record id="warefor_internal_transfer_kanban_view" model="ir.ui.view">
            <field name="name">warefor.internal.transfer.kanban.view</field>
            <field name="model">warefor.internal.transfer</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <kanban default_group_by="internal_transfer_stage_id" class="o_kanban_mobile" group_edit="true">
                    <field name="name"/>
                    <field name="freight_id" invisible="1"/>
                    <field name="warehouse_id"/>
                    <field name="date"/>
                    <field name="validate_user_ids"/>
                    <field name="validate_user_name"/>
                    <!--                    <field name="picking_id" invisible="1"/>-->
<!--                    <field name="status_id"/>-->
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div>
                                    <div>
                                        <div style="font-size: 18px">INTERNAL TRANSFER</div>
                                    </div>
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.name.value"/>
                                    </strong>
                                    <br/>
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.warehouse_id.value"/>
                                    </strong>
                                    <br/>
                                    <div>
                                        <strong>Date:</strong>
                                        <t t-esc="record.date.value"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_right">
                                             <t t-foreach="record.validate_user_ids.raw_value" t-as="img">
                                                 <img t-att-src="kanban_image('res.users', 'image_1920', img)"
                                                      t-att-title="record.validate_user_ids.value"
                                                      t-att-alt="record.validate_user_ids.value"
                                                      class="oe_kanban_avatar"/>
                                             </t>
                                        </div>
                                    </div>
                                    <div>
                                        <t t-esc="record.validate_user_name.value"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="warefor_internal_transfer_tree_view" model="ir.ui.view">
            <field name="name">warefor.internal.transfer.tree.view</field>
            <field name="model">warefor.internal.transfer</field>
            <field name="arch" type="xml">
                <tree string="Internal Transfer">
                    <field name="name"/>
                    <field name="freight_id" invisible="1"/>
                    <field name="warehouse_id"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

        <record id="warehouse_internal_transfer_search_view" model="ir.ui.view">
            <field name="name">warehouse.internal.transfer.search.view</field>
            <field name="model">warefor.internal.transfer</field>
            <field name="arch" type="xml">
                <search string="Internal Transfer">
                    <field name="name"/>
                    <filter string="Archived" name="active" domain="[('active','=',False)]"/>
                    <separator/>
                </search>
            </field>
        </record>

        <record id="warefor_internal_transfer_record_action" model="ir.actions.act_window">
            <field name="name">Internal Transfer</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warefor.internal.transfer</field>
            <field name="view_mode">kanban,form,search</field>
            <field name="context">{
                'is_ops_model': True,
                }
            </field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('warefor_3pl_tus.warefor_internal_transfer_kanban_view')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('warefor_3pl_tus.warefor_internal_transfer_tree_view')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('warefor_3pl_tus.warefor_internal_transfer_form_view')}),
                          ]"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

        <record id="warefor_internal_transfer_record_button_action" model="ir.actions.act_window">
            <field name="name">Internal Transfer</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warefor.internal.transfer</field>
            <field name="view_mode">form,tree</field>
            <field name="context">{
                'is_ops_model': True,
                }
            </field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('warefor_3pl_tus.warefor_internal_transfer_form_view')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('warefor_3pl_tus.warefor_internal_transfer_tree_view')}),
                          ]"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

        <record id="inherit_warefor_internal_transfer_form_view" model="ir.ui.view">
            <field name="name">inherit.warefor.internal.transfer.form.view</field>
            <field name="model">warefor.internal.transfer</field>
            <field name="inherit_id" ref="warefor_3pl_tus.warefor_internal_transfer_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
            </field>
        </record>

<!--        <menuitem id="menu_internal_transfer_root" name="Internal Transfer" sequence="10"-->
<!--                  web_icon="warefor_3pl_tus,static/description/shipment.png"/>-->

        <menuitem id="menu_internal_transfer_main" name="Internal Transfers"
                  parent="warefor_3pl_tus.menu_freight_osd_root" sequence="10"
                  action="warefor_3pl_tus.warefor_internal_transfer_record_action"/>

<!--        <menuitem id="menu_internal_transfer"-->
<!--                  name="Internal Transfer"-->
<!--                  parent="warefor_3pl_tus.menu_internal_transfer_main"-->
<!--                  action="warefor_3pl_tus.warefor_internal_transfer_record_action"-->
<!--                  sequence="12"/>-->

    </data>
</odoo>
