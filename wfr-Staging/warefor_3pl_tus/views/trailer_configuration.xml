<odoo>
    <data>
        <record id="trailer_configuration_form_view" model="ir.ui.view">
            <field name="name">trailer.configuration.form</field>
            <field name="model">trailer.configuration</field>
            <field name="arch" type="xml">
                <form string="Trailer Configuration">
                    <sheet>
                        <div class="oe_title" width="50%">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="trailer_size"/>
                                <field name="cu_ft"/>
                                <field name="pay_load_lbs"/>
                            </group>
                            <group>
                                <field name="cu_metric"/>
                                <field name="pay_load_kg"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="trailer_configuration_tree_view" model="ir.ui.view">
            <field name="name">trailer.configuration.tree</field>
            <field name="model">trailer.configuration</field>
            <field name="arch" type="xml">
                <tree string="Trailer Configuration">
                    <field name="name"/>
                    <field name="trailer_size"/>
                    <field name="cu_ft"/>
                    <field name="pay_load_lbs"/>
                </tree>
            </field>
        </record>

        <record id="trailer_configuration_action" model="ir.actions.act_window">
            <field name="name">Trailer Configuration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">trailer.configuration</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

        <menuitem id="menu_trailer_configuration" name="Trailer Configuration" action="trailer_configuration_action"
                  parent="warefor_3pl_tus.menu_pallet_mgmt_root" sequence="4"/>

    </data>
</odoo>