<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_extend_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.extend.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='warehouse_setting_container']" position="after">
                    <h2>Pallet Batch</h2>
                    <div class="row mt16 o_settings_container" name="settings_pallet_batch">
                        <div class="col-12 col-lg-6 o_setting_box" id="pallet_batch_email">
                            <div class="o_setting_left_pane">
                                <field name="pallet_batch_email_validation"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="pallet_batch_email_validation" string="Email Confirmation"/>
                                <div class="text-muted">Send an automatic confirmation email to the user when Pallet
                                    Batch is done
                                </div>
                                <div class="row mt16"
                                     attrs="{'invisible': [('pallet_batch_email_validation', '=', False)]}">
                                    <label for="pallet_batch_user_id" string="Email Sent to User"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="pallet_batch_user_id" class="oe_inline"
                                           attrs="{'required': [('pallet_batch_email_validation', '=', True)]}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="pallet_in_location">
                            <div class="o_setting_right_pane">
                                <label for="pallet_in_location" string="Pallet Configuration"/>
                                <div class="text-muted">Store the entered number of pallets per rack.</div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <span>
                                            <field name="pallet_in_location"/>
                                        </span>
                                    </div>
                                </div>
                                <label for="rack_in_location" string="Rack Configuration"/>
                                <div class="text-muted">Store the entered number of racks per location.</div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <span>
                                            <field name="rack_in_location"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//div[@name='warehouse_setting_container']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box" id="virtual_location_setting">
                        <div class="o_setting_left_pane">
                            <field name="use_virtual_location"/>

                        </div>
                        <div class="o_setting_right_pane">
                            <label for="use_virtual_location" string="Use Virtual Location?"/>
                            <div class="text-muted">Use the Virtual Location to receive products to Virtual Locations.</div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>