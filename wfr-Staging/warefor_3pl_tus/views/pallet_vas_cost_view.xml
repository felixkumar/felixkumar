<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="form_view_pallet_vas_cost" model="ir.ui.view">
            <field name="name">pallet.vas.cost.form.view</field>
            <field name="model">pallet.vas.cost</field>
            <field name="arch" type="xml">
                <form string="Pallet VAS Cost">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="unit_of_measure"/>
                                <field name="total_cost"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tree_view_pallet_vas_cost" model="ir.ui.view">
            <field name="name">pallet.vas.cost.tree.view</field>
            <field name="model">pallet.vas.cost</field>
            <field name="arch" type="xml">
                <tree string="Pallet VAS Cost">
                    <field name="name"/>
                    <field name="unit_of_measure"/>
                    <field name="total_cost" sum="Total Price"/>
                </tree>
            </field>
        </record>

    </data>
</odoo>