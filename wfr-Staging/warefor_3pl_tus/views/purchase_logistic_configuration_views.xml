<odoo>
    <data>
        <record id="purchase_logistic_configuration_form_view" model="ir.ui.view">
            <field name="name">purchase.logistic.configuration.form</field>
            <field name="model">purchase.logistic.configuration</field>
            <field name="arch" type="xml">
                <form string="Purchase Logistic Configuration">
                    <sheet>
                        <div class="oe_title" width="50%">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id"/>
                                <field name="warehouse_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="purchase_logistic_configuration_tree_view" model="ir.ui.view">
            <field name="name">purchase.logistic.configuration.tree</field>
            <field name="model">purchase.logistic.configuration</field>
            <field name="arch" type="xml">
                <tree string="Purchase Logistic Configuration">
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="warehouse_id"/>
                    </tree>
            </field>
        </record>

        <record id="purchase_logistic_configuration_action" model="ir.actions.act_window">
            <field name="name">Purchase Logistic Configuration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.logistic.configuration</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

        <menuitem id="menu_purchase_logistic_configuration" name="Purchase Logistic Configuration" action="purchase_logistic_configuration_action"
                  parent="purchase.menu_purchase_config" sequence="4"/>

    </data>
</odoo>
