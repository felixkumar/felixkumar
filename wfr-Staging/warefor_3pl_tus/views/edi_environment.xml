<odoo>
    <data>
        <record id="edi_environment_form" model="ir.ui.view">
            <field name="name">edi.environment.form</field>
            <field name="model">edi.environment</field>
            <field name="arch" type="xml">
                <form create="false" string="EDI Environment">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="mode"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="edi_environment_tree" model="ir.ui.view">
            <field name="name">edi.environment.tree</field>
            <field name="model">edi.environment</field>
            <field name="arch" type="xml">
                <tree create="false" string="EDI Environment">
                    <field name="name"/>
                    <field name="mode"/>
                </tree>
            </field>
        </record>

        <record id="edi_environment_action" model="ir.actions.act_window">
            <field name="name">EDI Environment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">edi.environment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_edi_environment" name="EDI Environment" action="edi_environment_action"
                  parent="stock.menu_stock_config_settings"/>

    </data>
</odoo>
