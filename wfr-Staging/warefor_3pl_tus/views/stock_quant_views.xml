<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="quant_3pl_search_view" model="ir.ui.view">
            <field name="name">stock.quant.3pl.search</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.quant_search_view" />
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_count']" position="after">
                    <filter name="my_stock_count" string="My Counts" domain="[('user_id', '=', uid)]"/>
                </xpath>
                <xpath expr="//filter[@name='my_count']" position="replace" />
            </field>
        </record>
    </data>
</odoo>

