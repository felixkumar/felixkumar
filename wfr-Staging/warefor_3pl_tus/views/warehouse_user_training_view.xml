<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="form_view_warehouse_user_training" model="ir.ui.view">
            <field name="name">warehouse.user.training.form.view</field>
            <field name="model">warehouse.user.training</field>
            <field name="arch" type="xml">
                <form string="Training Material">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="type"/>
                                <field name="training_filename" invisible="1"/>
                                <field name="training_file" filename="training_filename"/>
                                <field name="training_file_type" widget="radio"/>
                            </group>
                        </group>
                        <field name="training_file" widget="pdf_viewer"
                               attrs="{'invisible':  [('training_file_type', '!=', 'pdf')]}"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tree_view_warehouse_user_training" model="ir.ui.view">
            <field name="name">warehouse.user.training.tree.view</field>
            <field name="model">warehouse.user.training</field>
            <field name="arch" type="xml">
                <tree string="Training Material">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_warehouse_user_training_obl_views" model="ir.actions.act_window">
            <field name="name">Training Material</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warehouse.user.training</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[('type', '=', 'OBL')]</field>
        </record>

        <record id="action_warehouse_user_training_ibl_views" model="ir.actions.act_window">
            <field name="name">Training Material</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warehouse.user.training</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[('type', '=', 'IBL')]</field>
        </record>

        <record id="action_warehouse_user_training_inventory_views" model="ir.actions.act_window">
            <field name="name">Training Material</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warehouse.user.training</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[('type', '=', 'INVENTORY')]</field>
        </record>

        <record id="action_warehouse_user_training_w_ops_views" model="ir.actions.act_window">
            <field name="name">Training Material</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warehouse.user.training</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[('type', '=', 'WAREHOUSE-OPS')]</field>
        </record>

        <menuitem id="menu_warehouse_user_training_obl"
          name="Training Material"
          action="action_warehouse_user_training_obl_views"
          parent="warefor_3pl_tus.menu_freight_outbound_root"
          sequence="11001"
        />

        <menuitem id="menu_warehouse_user_training_ibl" action="action_warehouse_user_training_ibl_views"
                  name="Training Material" parent="warefor_3pl_tus.menu_freight_root" sequence="11001"/>
        <menuitem id="menu_warehouse_user_training_w_ops" action="action_warehouse_user_training_w_ops_views"
                  name="Training Material" parent="warefor_3pl_tus.menu_freight_osd_root" sequence="11002"/>
        <menuitem id="menu_warehouse_user_training_inventory" action="action_warehouse_user_training_inventory_views"
                  name="Training Material" parent="stock.menu_stock_root" sequence="11003"/>

    </data>
</odoo>
