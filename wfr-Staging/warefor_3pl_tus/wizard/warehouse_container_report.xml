<odoo>
    <record id="view_container_report_wizard_form" model="ir.ui.view">
        <field name="name">view.container.report.wizard.form</field>
        <field name="model">container.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="start_date" required="1"/>
                        <field name="partner_id" options="{'no_create': True,'no_edit': True}"/>
                    </group>
                    <group>
                        <field name="end_date" required="1"/>
                        <field name="warehouse_id" options="{'no_create': True,'no_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate excel report" type="object" class="btn btn-primary"
                            name="generate_xlxs_report"/>
                    <button string="cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_container_report_wizard" model="ir.actions.act_window">
        <field name="name">Warehouse Container Report</field>
        <field name="res_model">container.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="website_sale_extended_wizard"
              name="Warehouse Container Report"
              action="action_container_report_wizard"
              parent="warefor_3pl_tus.menu_freight_freights_inbound_report"
              sequence="11"/>
</odoo>