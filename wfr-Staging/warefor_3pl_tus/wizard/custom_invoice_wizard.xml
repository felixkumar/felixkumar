<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_custom_invoice_wizard_form" model="ir.ui.view">
            <field name="name">view.custom.invoice.wizard.form</field>
            <field name="model">custom.invoice.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="invoice_type" required="1"/>
                            <field name="end_date" attrs="{'invisible': [('invoice_type', '!=', 'wfl_storage')], 'required': [('invoice_type', '=', 'wfl_storage')]}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="create_custom_invoice_wizard" string="Create Invoice" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="act_custom_invoice_wizard_1" model="ir.actions.act_window">
            <field name="name">Custom Invoice Wizard</field>
            <field name="res_model">custom.invoice.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_custom_invoice_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>