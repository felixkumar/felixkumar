<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_warehouse_manager_signature_form" model="ir.ui.view">
            <field name="name">view.warehouse.manager.signature.wizard.form</field>
            <field name="model">warehouse.manager.signature.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name" invisible="1"/>
                            <field name="signature" widget="signature" string="Sign" full_name="name"/>
                            <field name="signature_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="update_warehouse_manager_signature" string="Update Signature" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_warehouse_manager_signature_wizard" model="ir.actions.act_window">
            <field name="name">Update Signature Wizard</field>
            <field name="res_model">warehouse.manager.signature.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_warehouse_manager_signature_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>