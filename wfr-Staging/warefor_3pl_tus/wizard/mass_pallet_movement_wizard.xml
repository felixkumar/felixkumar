<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mass_pallets_movement_wizard_form" model="ir.ui.view">
            <field name="name">view.mass.pallets.movement.wizard.form</field>
            <field name="model">mass.pallets.movement</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="purchase_id"/>
                        </group>
                        <group>
                            <field name="location_id" required="1"/>
                        </group>
                        <group>
                            <field name="pallet_ids" widget="many2many_tags" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="move_po_pallets" string="Move Pallets" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="mass_pallets_movement_action" model="ir.actions.act_window">
            <field name="name">Move Pallets From Wizard</field>
            <field name="res_model">mass.pallets.movement</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_mass_pallets_movement_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_move_pallets" name="Move Pallets" action="mass_pallets_movement_action"
                  parent="warefor_3pl_tus.menu_pallet_mgmt_root" sequence="1"/>

    </data>
</odoo>