<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_custom_credit_memo_wizard_form" model="ir.ui.view">
            <field name="name">view.custom.credit.memo.wizard.form</field>
            <field name="model">custom.credit.memo.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="invoice_id"  required="1" domain="[('id','in',context.get('invoice_id_domain',[]))]"/>
                        </group>
                    </group>
                    <footer>
                        <button name="create_credit_memo" string="Create Invoice" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_custom_credit_memo_wz" model="ir.actions.act_window">
            <field name="name">Credit Memo Wizard</field>
            <field name="res_model">custom.credit.memo.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_custom_credit_memo_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>