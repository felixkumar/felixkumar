<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_inventory_transfer_form" model="ir.ui.view">
            <field name="name">view.inventory.transfer.wizard.form</field>
            <field name="model">transfer.inventory.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="location_id" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="open_wizard_for_transfer_inventory" string="Transfer Inventory" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_inventory_transfer_wizard" model="ir.actions.act_window">
            <field name="name">Inventory Transfer Wizard</field>
            <field name="res_model">transfer.inventory.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_inventory_transfer_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>