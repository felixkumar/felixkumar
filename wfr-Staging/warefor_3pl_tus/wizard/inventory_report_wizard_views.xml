<odoo>
    <record id="view_inventory_report_wizard_form_view" model="ir.ui.view">
        <field name="name">inventory.report.wizard.form</field>
        <field name="model">inventory.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="category_id" options="{'no_create': True,'no_create_edit': True}"/>
                        <field name="partner_id" options="{'no_create': True,'no_create_edit': True}" invisible="1"/>
                        <field name="warehouse_ids" options="{'no_create': True,'no_create_edit': True}" widget="many2many_tags"/>
                        <field name="title_name"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate excel report" type="object" class="btn btn-primary"
                            name="generate_xlsx_report"/>
                    <button string="cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_inventory_report_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Report</field>
        <field name="res_model">inventory.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="inventory_report_menu"
              name="Inventory Report"
              action="action_inventory_report_wizard"
              parent="stock.menu_warehouse_report"
              sequence="11"/>
</odoo>