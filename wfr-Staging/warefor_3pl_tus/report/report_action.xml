    <record id="logistic_pallet_label_paper_format" model="report.paperformat">
        <field name="name">Logistic Pallet Label Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">240</field>
        <field name="page_width">100</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="logistic_pallet_label" model="ir.actions.report">
        <field name="name">Pallet Label</field>
        <field name="model">freight.freight</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">warefor_3pl_tus.report_logistic_pallet_label</field>
        <field name="report_file">warefor_3pl_tus.report_logistic_pallet_label</field>
        <field name="print_report_name">'Pallet Label-%s' % object.name</field>
        <field name="binding_model_id" ref="model_freight_freight"/>
        <field name="paperformat_id" ref="warefor_3pl_tus.logistic_pallet_label_paper_format"/>
        <field name="binding_type">report</field>
    </record>

