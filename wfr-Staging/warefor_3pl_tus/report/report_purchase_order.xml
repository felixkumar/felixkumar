<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_custom_po_document">
            <t t-call="web.basic_layout">
                <div class="page" style="padding-top: 10px !important; padding-left: 0px !important;">
                    <style>
                        .text_label{
                        width:350px;
                        height:20px !important;
                        background-color: #b8b8b8;
                        font-size:12px;
                        }
                        .text_data{
                        height:15px !important;
                        font-size:12px;
                        }
                        .header_text_label{
                        font-size:12px;
                        background-color: #b8b8b8;
                        }
                        .border-heading-row td{
                        background-color: #b8b8b8;
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        width:40px !important;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row td{
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        width:40px !important;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row-note td{
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        width:40px !important;
                        border-right:none !important;
                        }
                        .border-heading-main td{
                        border-right:none;
                        border-left:none;
                        }
                        .border-heading-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-heading-main td:last-child{
                        border-right:1px solid #000 !important;
                        }
                        .border-heading-right-main td:last-child{
                        border-right:1px solid #000 !important;
                        padding-right: 10px !important;
                        }
                        .border-heading-left-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-top-main td{
                        border-top:1px solid #000 !important;
                        }
                        .table th, .table td {
                        padding: 3px;
                        }
                        .display-table{
                        width:100% !important;
                        font-size:12px !important;
                        text-align:center;
                        line-height:25px;
                        margin:0 !important;
                        padding:0 !important;
                        border-bottom:hidden !important;
                        }
                        .display-table tr,.display-table td{
                        border: none;
                        }
                        .display-table tr{
                        width:100% !important;
                        font-size:12px !important;
                        text-align:center;
                        line-height:25px;
                        margin:0 !important;
                        padding:0 !important;
                        border-right:1px solid #000 !important;
                        }
                        .display-table thead{
                        border-bottom:1px solid #000;
                        border-top:1px solid #000;
                        }
                        .display-table td:nth-child(1){
                        width:80px !important;
                        }
                        .display-table td:nth-child(2){
                        width:80px !important;
                        }
                        .display-table td:nth-child(3){
                        width:280px !important;
                        }
                        .display-table td:nth-child(4){
                        width:120px !important;
                        }
                        .display-table td:nth-child(5){
                        width:120px !important;
                        }
                        .display-table td:nth-child(6){
                        width:80px !important;
                        }
                        .display-table td:nth-child(7){
                        width:80px !important;
                        }
                    </style>
                    <t t-set="line_length" t-value="1"/>
                    <table class="table mt32" style="float:left;width:100%;font-size:12px !important;" cellspacing="0">
                        <tbody style="line-height:normal;border: 1px solid white;">
                            <td style="width: 80%; padding-left: 15px;border: 1px solid white;">
                                <!--                                <img t-att-src="image_data_uri(o.company_id.logo_web)"-->
                                <!--                                     style="height: 45px;width: 205px;" alt="Logo"/>-->
                                <img src="warefor_3pl_tus/static/src/img/warefor_logo.png" style="height: 45px;width: 205px;" alt="Logo"/>
                                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                                <br/>
                                <b t-esc="o.company_id.partner_id.name"/>
                                <br/>
                                <t t-esc="o.company_id.partner_id.street"/>
                                <br/>
                                <t t-esc="o.company_id.partner_id.city"/><t t-if="o.company_id.partner_id.city">,</t>
                                <t t-esc="o.company_id.partner_id.state_id.code"/>
                                <t t-esc="o.company_id.partner_id.zip"/>
                                <br/>
                                <span>(832) 568-4114</span>
                                <br/>
                                <span>ap@warefor.com</span>

                            </td>
                            <td style="width: 30%;border-top: 1px solid white; padding-left:50px;">
                                <div style="width:300px; background-color: #b8b8b8; font-size:12px;border-top: 1px solid white;">
                                    <p style="text-align: center;">
                                        <b>PURCHASE ORDER</b>
                                    </p>
                                </div>
                                <span>P.O. #</span>
                                <span style="padding-left: 63px;">
                                    <b t-esc="o.name"/>
                                </span>
                                <br/>
                                <span>P.O. Date:</span>
                                <span style="padding-left: 40px;">
                                    <b t-esc="o.date_approve and o.date_approve.strftime('%m/%d/%y')"/>
                                </span>
                                <br/>
                                <br/>
                                <br/>
                            </td>
                        </tbody>
                        <tbody style="line-height:normal;border: 1px solid white;">
                            <td colspan="2" style="text-align:center;border: 1px solid white;">
                                <hr width="100%" style="background-color:#707070;border: 1.6px solid #707070;min-height:1px; padding:0px; margin:0px;"/>
                            </td>
                        </tbody>
                    </table>

                    <table style="line-height:normal;border: 1px solid white;width:100%;font-size:12px !important;">
                        <tr>
                            <td style="width:50%;">
                                <table style="width:100%;height:100px;border: 1px solid white;">
                                    <tr>
                                        <td style="width:30%;padding-left: 12px;">
                                            Name :
                                        </td>
                                        <td style="width:70%;">
                                            <t t-esc="o.partner_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:30%;padding-left: 12px;">Address:</td>
                                        <td style="width:70%;">
                                            <t t-esc="o.partner_id.street"/>
                                            <t t-if="o.partner_id.street2">
                                                <br/>
                                                <t t-esc="o.partner_id.street2"/>
                                            </t>
                                            <br/>
                                            <t t-esc="o.partner_id.city"/><t t-if="o.partner_id.city">,</t>
                                            <t t-esc="o.partner_id.state_id.code"/>
                                            <t t-esc="o.partner_id.zip"/>
                                            <br/>
                                            <t t-esc="o.partner_id.country_id.name"/>
                                            <br/>
                                            <!--                                            <address t-field="o.partner_id"-->
                                            <!--                                         t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: True}"/>-->
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:50%;">
                                <table style="width:100%;height:100px;border: 1px solid white;">
                                    <tr>
                                        <td style="width:30%;padding-left:10px;">
                                            <span>Contact Name :</span>
                                            <br/>
                                            <span>Tel #:</span>
                                            <br/>
                                            <span>E-mail :</span>
                                            <br/>
                                        </td>
                                        <td style="width:70%;">
                                            <span>
                                                <t t-esc="o.partner_id.name"/>
                                            </span>
                                            <br/>
                                            <span>
                                                <t t-esc="o.partner_id.phone"/>
                                            </span>
                                            <br/>
                                            <span>
                                                <t t-esc="o.partner_id.email"/>
                                            </span>
                                            <br/>

                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:30%;"/>
                                        <td style="width:70%;"/>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table class="table mt32" style="float:left;width:100%;font-size:12px !important;" cellspacing="0">
                        <tbody style="line-height:normal;border: 1px solid white;">
                            <td style="padding:2px;border: 1px solid white;">
                                <div class="text_label" style="padding-left: 12px; padding-top: 4px;">
                                    <b>BILL TO</b>
                                </div>
                                <div style="padding-left: 10px;">
                                    <br/>
                                    <b>
                                        <t t-esc="o.company_id.partner_id.name or ''"/>
                                    </b>
                                    <br/>
                                    <t t-esc="o.company_id.partner_id.street"/>
                                    <t t-if="o.company_id.partner_id.street2">
                                        <br/>
                                        <t t-esc="o.company_id.partner_id.street2"/>
                                    </t>
                                    <br/>
                                    <t t-esc="o.company_id.partner_id.city"/><t t-if="o.company_id.partner_id.city">,</t>
                                    <t t-esc="o.company_id.partner_id.state_id.code"/>
                                    <t t-esc="o.company_id.partner_id.zip"/>
                                    <br/>
                                    <t t-esc="o.company_id.partner_id.country_id.name"/>
                                    <br/>

                                    <!--                                    <address t-field="o.company_id.partner_id"-->
                                    <!--                                         t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: True}"/>-->
                                </div>
                            </td>
                            <td style="padding:2px;border: 1px solid white;">
                                <div class="text_label" style="padding-left: 10px; padding-top: 4px;">
                                    <b>SHIP TO</b>
                                </div>
                                <t t-set="warehouse" t-value="o.picking_type_id.warehouse_id.partner_id"/>
                                <div style="padding-left: 10px;">
                                    <br/>
                                    <b>
                                        <t t-esc="warehouse.name or ''"/>
                                    </b>
                                    <br/>
                                    <t t-esc="warehouse.street"/>
                                    <t t-if="warehouse.street2">
                                        <br/>
                                        <t t-esc="warehouse.street2"/>
                                    </t>
                                    <br/>
                                    <t t-esc="warehouse.city"/><t t-if="warehouse.city">,</t>
                                    <t t-esc="warehouse.state_id.code"/>
                                    <t t-esc="warehouse.zip"/>
                                    <br/>
                                    <t t-esc="warehouse.country_id.name"/>
                                    <br/>
                                </div>
                            </td>
                        </tbody>
                    </table>
                    <br/><br/>

                    <table class="table mt32" style="width:100%; float:left;font-size:12px !important;margin-bottom: 15px !important;" cellspacing="0">
                        <tr class="border-heading-row border-heading-right-main border-heading-left-main">
                            <td style="width:20% !important;text-align: left !important;padding-left: 12px;" class="header_text_label">
                                Order By
                            </td>
                            <td style="width:20% !important;text-align: left !important;" class="header_text_label">
                                Payment Terms
                            </td>
                            <td style="width:20% !important;text-align: left !important;" class="header_text_label">
                                Ship Via
                            </td>
                            <td style="width:20% !important;text-align: left !important;" class="header_text_label">
                                Freight
                            </td>
                            <td style="width:20% !important;text-align: left !important;" class="header_text_label">
                                Currency
                            </td>
                        </tr>

                        <t t-if="o.order_line">
                            <tr class="text_data border-sub-row border-heading-right-main border-heading-left-main">
                                <td style="width:20% !important;text-align:left;padding-left: 12px;" class="text_data">
                                    <t t-esc="o.user_id.name"/>
                                </td>
                                <td style="width:20% !important;text-align: left !important;" class="text_data">
                                    <t t-esc="o.payment_term_id.name or ''"/>
                                </td>
                                <td style="width:20% !important;text-align: left !important;" class="text_data">
                                    <t t-esc="o.ship_via"/>
                                </td>
                                <td style="width:20% !important;text-align: left !important;" class="text_data">
                                    <t t-esc="o.incoterm_id.name"/>
<!--                                    <t t-if="o.freight_record">-->
<!--                                      <t t-esc="o.freight_record.name"/>-->
<!--                                    </t>-->
<!--                                    <t t-else=" ">-->
<!--                                      <t t-esc="o.logistic_record_id.name"/>-->
<!--                                    </t>-->
                                </td>
                                <td style="width:20% !important;text-align: left !important;" class="text_data">
                                    <t t-esc="o.company_id.currency_id.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr class="text_data border-sub-row border-heading-right-main border-heading-left-main">
                                <td style="height:15px;" colspan="7"/>
                            </tr>
                        </t>
                    </table>
                    <br/><br/><br/><br/><br/>

                    <div style="border:1px solid #000;border-top: hidden !important;margin-top:60px;display:block;">
                        <table class="display-table" style="display:block;min-height: 520px !important;">
                            <thead style="background-color:#b8b8b8 !important;color:#212529 !important;border-right:hidden !important;">
                                <td class="text_data" style="text-align: left;padding-left: 12px;">Line #</td>
                                <td class="text_data">Item #</td>
                                <td class="text_data" style="text-align: left; padding-left:10px;">Description</td>
                                <td class="text_data" style="text-align: right;padding-right:15px;">Quantity</td>
                                <td class="text_data" style="text-align: right;">Unit Price</td>
                                <td class="text_data">Taxes</td>
                                <td class="text_data">Total Price</td>
                            </thead>
                            <tr t-foreach="o.order_line" t-as="invoice_line" style="border-bottom:hidden !important;border-right:hidden !important;">
                                <td class="text_data" style="text-align: left;padding-left: 12px;">
                                    <span t-esc="line_length"/>
                                    <t t-set="line_length" t-value="line_length + 1"/>
                                </td>
                                <td class="text_data">
                                    <span t-esc="invoice_line.product_id.default_code"/>
                                </td>
                                <td class="text_data" style="text-align: left;padding-left:10px;">
                                    <span t-esc="invoice_line.product_id.name"/>
                                </td>
                                <td class="text_data" style="text-align: right;padding-right:15px;">
                                    <span t-esc="int(invoice_line.product_qty)"/>
                                </td>
                                <td class="text_data" style="text-align: right;">
                                    <span t-field="invoice_line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                                <td class="text_data">
                                    <t t-if="invoice_line.taxes_id">
                                        <t t-esc="', '.join(invoice_line.taxes_id.mapped('name'))"/>
                                    </t>
                                    <t t-else="">N/A</t>
                                </td>
                                <td class="text_data" style="text-align: right;padding-right:8px !important;">
                                    <span t-field="invoice_line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <table class="table mt32" width="100%" style="font-size:12px !important;border-top:hidden !important;" cellspacing="0">
                        <tr class="border-sub-row-note border-heading-right-main border-heading-left-main" style="line-height: normal;">
                            <td width="50%" colspan="6" style="padding: 10px 0px 0px 10px !important;vertical-align: top;text-wrap: nowrap;">
<!--                                <div style="float:left;">-->
                                    <span>
                                        <b>NOTES:</b>
                                    </span>
                                    <br/>
                                    <t t-esc="o.notes"/>
<!--                                </div>-->
                            </td>
                            <td style="width:250px; padding-left: 10px !important;padding-left: 0px !important;padding-right: 0px !important;padding-bottom: 0px;border-bottom:1px solid #000;">
                                <div style="width:200px; float:left;white-space: nowrap; padding: 6px 10px 3px 10px;">
                                    <div style="float:left;">Sub Total</div>
                                    <div type="text" style="text-align:right;width:95px;float:right;">
                                        <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </div>
                                </div>

                                <div style="width:200px; float:left;padding: 3px 10px 3px 10px;">
                                    <div style=" float:left;">Taxes</div>
                                    <div type="text" style="text-align:right;width:95px;float:right;">
                                        <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </div>
                                </div>
                                <div style="width:200px; background-color: #b8b8b8;float:left;padding: 3px 10px 6px 10px;">
                                    <b style="float:left;">Total</b>
                                    <div type="text" style="text-align:right;width:95px;float:right;">
                                        <b t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </template>

        <template id="report_custom_purchase_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="warefor_3pl_tus.report_custom_po_document" t-lang="lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
