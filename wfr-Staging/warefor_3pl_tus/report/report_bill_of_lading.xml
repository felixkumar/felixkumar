<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_bill_of_ladding">
            <t t-call="web.basic_layout">

                <div class="page" style="padding-top: 10px !important; padding-left: 0px !important;">
                    <style>
                        .text_label{
                        width:350px;
                        height:20px !important;
                        background-color: #b8b8b8;
                        font-size:12px;
                        }
                        .text_data{
                        height:15px !important;
                        font-size:12px;
                        }
                        .header_text_label{
                        font-size:12px;
                        background-color: #b8b8b8;
                        }
                        .border-heading-row td{
                        background-color: #b8b8b8;
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row td{
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        line-height:15px;
                        text-align:center;
                        width:40px !important;
                        border-right:none !important;
                        border-left:none !important;
                        }
                        .border-sub-row-note td{
                        font-size:12px;
                        border: 1px solid #000;
                        border-spacing:0px;
                        width:40px !important;
                        border-right:none !important;
                        }
                        .border-heading-main td{
                        border-right:none;
                        border-left:none;
                        }
                        .border-heading-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-heading-main td:last-child{
                        border-right:1px solid #000 !important;
                        }
                        .border-heading-right-main td:last-child{
                        border-right:1px solid #000 !important;
                        padding-right: 10px !important;
                        }
                        .border-heading-left-main td:first-child{
                        border-left:1px solid #000 !important;
                        }
                        .border-top-main td{
                        border-top:1px solid #000 !important;
                        }
                        .table th, .table td {
                        padding: 3px;
                        }

                        .display-table{
                        border:1px solid #000;
                        font-size:12px !important;
                        text-align:center;
                        line-height:25px;
                        margin:0 !important;
                        padding:0 !important;
                        border-bottom:hidden !important;
                        }
                        .display-table tr{
                        width:100% !important;
                        }
                        .display-table thead{
                        border-top:1px solid #000;
                        border-bottom:1px solid #000;
                        }
                        .display-table td:nth-child(1){
                        width:60px !important;
                        }
                        .display-table td:nth-child(2){
                        width:120px !important;
                        }
                        .display-table td:nth-child(3){
                        width:280px !important;
                        }
                        .display-table td:nth-child(4){
                        width:80px !important;
                        }
                        .display-table td:nth-child(5){
                        width:70px !important;
                        }
                        .display-table td:nth-child(6){
                        width:80px !important;
                        }
                        .display-table td:nth-child(7){
                        width:70px !important;
                        }
                        .display-table td:nth-child(8){
                        width:80px !important;
                        }
                        .left-right-border{
                        border-left:1px solid #000 !important;
                        border-right:1px solid #000 !important;
                        text-align: center;
                        font-size: 12px;
                        }
                    </style>
                    <t t-foreach="docs" t-as="o">

                        <table class="table mt32" style="width:100%;font-size:12px !important;"
                               cellspacing="0">
                            <tbody style="line-height:normal;border: 1px solid white;">
                                <td style="width: 80%; padding-left: 15px;border: 1px solid white;">
                                    <!--                                <img t-att-src="image_data_uri(o.company_id.logo_web)"-->
                                    <!--                                     style="height: 45px;width: 205px;" alt="Logo"/>-->
                                    <img src="warefor_3pl_tus/static/src/img/warefor_logo.png"
                                         style="height: 45px;width: 205px;" alt="Logo"/>
                                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                                    <br/>
                                    <b t-esc="o.company_id.partner_id.name"/>
                                    <br/>
                                    <t t-esc="o.company_id.partner_id.street"/>
                                    <br/>
                                    <t t-esc="o.company_id.partner_id.city"/>,
                                    <t t-esc="o.company_id.partner_id.state_id.code"/>
                                    <t t-esc="o.company_id.partner_id.zip"/>
                                    <br/>
<!--                                    <t t-esc="o.company_id.partner_id.phone"/>-->
                                    <span>(832) 568-4119</span>
                                    <br/>
<!--                                    <t t-esc="o.company_id.partner_id.email"/>-->
                                    <span>logistics@warefor.com</span>
                                </td>
                                <td style="width: 30%;border-top: 1px solid white; padding-left:50px">
                                    <div style="width:300px; background-color: #b8b8b8; font-size:12px;border-top: 1px solid white;">
                                        <p style="text-align: center;">
                                            <b>BILL OF LADING</b>
                                        </p>
                                    </div>
                                    <span>BOL #:</span>
                                    <span style="padding-left: 63px;">
                                        <b t-esc="o.freight_record_id.bol_number"/>
                                    </span>
                                    <br/>
                                    <br/>
                                    <span>BOL Date:</span>
                                    <span style="padding-left: 45px;">
                                        <b t-esc="o.date_done and o.date_done.strftime('%m/%d/%y')"/>
                                    </span>
                                </td>
                            </tbody>
                            <tbody style="line-height:normal;border: 1px solid white;">
                                <td colspan="2" style="text-align:center;border: 1px solid white;">
                                    <hr width="100%"
                                        style="background-color:#707070;border: 1.6px solid #707070;min-height:1px; padding:0px; margin:0px;"/>
                                </td>
                            </tbody>
                            <t t-set="warehouse"
                               t-value="o.freight_record_id.ship_from_partner_id"/>
                            <tbody style="line-height:normal;border: 1px solid white;">
                                <td style="padding:2px;border: 1px solid white;">
                                    <div class="text_label" style="padding-left: 12px; padding-top: 3px;">
                                        <b>SHIP FROM :</b>
                                    </div>
                                    <div style="padding-left: 15px;height: 100px;">
                                        <br/>
                                        <b>
                                            <t t-esc="warehouse.name or ''"/>
                                        </b>
                                        <br/>
                                        <t t-esc="warehouse.street"/>
                                        <t t-if="warehouse.street2">
                                            <br/>
                                            <t t-esc="warehouse.street2"/>
                                        </t>
                                        <br/>
                                        <t t-esc="warehouse.city"/><t t-if="warehouse.city">,</t>
                                        <t t-esc="warehouse.state_id.code"/>
                                        <t t-esc="warehouse.zip"/>
                                        <br/>
                                        <t t-esc="warehouse.country_id.name"/>
                                        <br/>
                                    </div>
                                </td>
                                <td style="padding:2px;border: 1px solid white;">
                                    <div class="text_label" style="padding-left: 15px; padding-top: 3px;">
                                        <b>SHIP TO :</b>
                                    </div>
                                    <div style="padding-left: 15px;height: 100px;">
                                        <br/>
                                        <b>
                                            <t t-esc="o.freight_record_id.outbound_partner_id.name or ''"/>
                                        </b>
                                        <br/>
                                        <t t-esc="o.freight_record_id.outbound_partner_id.street"/>
                                        <t t-if="o.freight_record_id.outbound_partner_id.street2">
                                            <br/>
                                            <t t-esc="o.freight_record_id.outbound_partner_id.street2"/>
                                        </t>
                                        <br/>
                                        <t t-esc="o.freight_record_id.outbound_partner_id.city"/><t t-if="o.freight_record_id.outbound_partner_id.city">,</t>
                                        <t t-esc="o.freight_record_id.outbound_partner_id.state_id.code"/>
                                        <t t-esc="o.freight_record_id.outbound_partner_id.zip"/>
                                        <br/>
                                        <t t-esc="o.freight_record_id.outbound_partner_id.country_id.name"/>
                                        <br/>
                                    </div>
                                </td>
                            </tbody>
                        </table>
<!--                        <br/><br/><br/><br/>-->

                        <table class="table mt32"
                               style="width:100%; font-size:12px !important; margin-bottom: 15px !important;"
                               cellspacing="0">
                            <thead class="border-heading-row border-heading-right-main border-heading-left-main">
                                <td width="25%" class="header_text_label">
                                    Vendor #
                                </td>
                                <td width="25%" class="header_text_label">
                                    Reference #
                                </td>
                                <td width="25%" class="header_text_label">
                                    Customer PO #
                                </td>
                                <td width="25%" class="header_text_label">
                                    PO Date
                                </td>
                            </thead>
                            <tr class="border-sub-row border-heading-right-main border-heading-left-main">
                                <td width="25%" class="text_data">
                                    <t t-esc="o.freight_record_id.vendor_code_id.code"/>
                                </td>
                                <td width="25%" class="text_data">
                                    <t t-esc="o.freight_record_id.reference"/>
                                </td>
                                <td width="25%" class="text_data">
                                    <t t-esc="o.freight_record_id.customer_po or ''"/>
                                </td>
                                <td width="25%" class="text_data">
                                    <t t-if="o.freight_record_id.po_date">
                                        <t t-esc="o.freight_record_id.po_date and o.freight_record_id.po_date.strftime('%m/%d/%y')"/>
                                    </t>
                                    <t t-else="">
                                        <span>N/A</span>
                                    </t>
                                </td>
                            </tr>
                        </table>
<!--                        <br/><br/><br/><br/><br/>-->

                        <table class="table mt32"
                               style="width:100%; font-size:12px !important; margin-bottom: 15px !important;"
                               cellspacing="0">
                            <thead class="border-heading-row border-heading-right-main border-heading-left-main">
                                <td width="25%" class="header_text_label">
                                    Carrier Name
                                </td>
                                <td width="25%" class="header_text_label">
                                    Driver Name
                                </td>
                                <td width="25%" class="header_text_label">
                                    Trailer #
                                </td>
                                <td width="25%" class="header_text_label">
                                    Seal #
                                </td>
                            </thead>
                            <tr class="border-sub-row border-heading-right-main border-heading-left-main">
                                <td width="25%" class="text_data">
                                    <t t-esc="o.freight_record_id.carrier_flight.name"/>
                                </td>
                                <td width="25%" class="text_data">
                                    <t t-esc="o.truck_driver_name.name"/>
                                </td>
                                <td width="25%" class="text_data">
                                    <t t-esc="o.trailer"/>
                                </td>
                                <td width="25%" class="text_data">
                                    <t t-esc="o.seal_number or ''"/>
                                </td>
                            </tr>
                        </table>
<!--                        <br/><br/><br/><br/><br/>-->

                        <table class="table"
                               style="width:100%; font-size:12px !important;margin-bottom: 15px !important;"
                               cellspacing="0">
                            <thead class="border-heading-row border-heading-right-main border-heading-left-main">
                                <td style="width:20% !important" class="header_text_label">
                                    Loading Date
                                </td>
                                <td style="width:20% !important" class="header_text_label">
                                    Departure Date
                                </td>
                                <td style="width:20% !important" class="header_text_label">
                                    Schedule Time
                                </td>
                                <td style="width:20% !important" class="header_text_label">
                                    Arrive Time
                                </td>
                                <td style="width:20% !important" class="header_text_label">
                                    Departure Time
                                </td>
                            </thead>
                            <tr class="text_data border-sub-row border-heading-right-main border-heading-left-main">
                                <td style="width:20% !important;" class="text_data">
                                    <t t-esc="o.freight_record_id.date_order and o.freight_record_id.date_order.strftime('%m/%d/%y')"/>
                                </td>
                                <td style="width:20% !important;" class="text_data">
                                    <t t-esc="o.freight_record_id.date_order and o.freight_record_id.date_order.strftime('%m/%d/%y')"/>
                                </td>
                                <td style="width:20% !important" class="text_data">
                                    <t t-esc="o.scheduled_date and o.scheduled_date.strftime('%I:%M %p')"/>
                                </td>
                                <td style="width:20% !important" class="text_data">
                                    <t t-esc="o.arrive_time and o.arrive_time.strftime('%I:%M %p')"/>
                                </td>
                                <td style="width:20% !important" class="text_data">
                                    <t t-esc="o.freight_record_id.date_order and o.freight_record_id.date_order.strftime('%I:%M %p')"/>
                                </td>
                            </tr>
                        </table>
<!--                        <br/><br/><br/><br/><br/>-->

                        <t t-set="line_length" t-value="1"/>
                            <table class="display-table" style="display:block;min-height: 380px !important;border-top: hidden !important;margin-top:5px !important;">
<!--                            <thead>-->
                                <thead style="background-color:#b8b8b8 !important;color:#212529 !important;">
                                    <td class="text_data">Line #</td>
                                    <td class="text_data">Item #</td>
                                    <td class="text_data" style="text-align: left; padding-left:15px;">Description</td>
                                    <td class="text_data">Lot #</td>
                                    <td class="text_data">Quantity</td>
                                    <td class="text_data">UOM</td>
                                    <td class="text_data" style="text-align: right;padding-right:2px;">Pallets</td>
                                    <td class="text_data">Net Weight</td>
                                </thead>
                                <t t-set="total_weight" t-value="0"/>
                                <tr t-foreach="o.move_line_ids_without_package" t-as="move_line"
                                    style="page-break-after:always;">
                                    <td class="text_data">
                                        <span t-esc="line_length"/>
                                        <t t-set="line_length" t-value="line_length + 1"/>
                                    </td>
                                    <td class="text_data">
                                        <span t-esc="move_line.product_id.default_code"/>
                                    </td>
                                    <td class="text_data" style="text-align: left;padding-left:15px;">
                                        <span t-esc="move_line.product_id.name"/>
                                    </td>
                                    <td class="text_data">
                                        <span t-esc="move_line.lot_id.name"/>
                                    </td>
                                    <td class="text_data" style="text-align: right;padding-right:5px;">
                                        <span t-esc="ceil(move_line.qty_done or 0)"/>
                                    </td>
                                    <td class="text_data">
                                        <span t-esc="move_line.product_uom_id.name"/>
                                    </td>
                                    <td class="text_data" style="text-align: right;">
                                        <span t-esc="int(move_line.no_of_pallets)"/>
                                    </td>
                                    <td class="text_data" style="text-align: right;padding-right:8px !important;">
                                        <t t-set="total_w" t-value="round(move_line.product_id.weight * move_line.qty_done, 2)"/>
                                        <span t-esc="'{:,d}'.format(int(total_w) or 0)"/>
                                        <t t-set="total_weight"
                                           t-value="total_weight + round(move_line.product_id.weight * move_line.qty_done, 2)"/>
                                    </td>
                                </tr>
                            <!--                                <tr>-->
                        </table>




                        <table class="left-right-border" style="width:100%">
                            <tr>
                                <td style="width:50%;height:25px;">
                                    <span class="image">
                                        <img t-if="o.env.user.user_signature" t-att-src="image_data_uri(o.env.user.user_signature)"
                                             style="max-height:1.5cm;max-width:8cm;" alt="Signature"/>
                                    </span>
                                </td>
                                <td style="width:50%;">
                                    <span class="image">
                                        <img t-if="o.truck_driver_signature" t-att-src="image_data_uri(o.truck_driver_signature)"
                                             style="max-height:1.5cm;max-width:8cm;x" alt="Signature"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span>_________________________________________</span><br/>
                                    <span>Warehouse Manager :</span> <span> <t t-esc="o.env.user.name"/></span>
                                </td>
                                <td>
                                    <span>_________________________________________</span><br/>
                                    <span>Truck Driver :</span><span> <t t-esc="o.truck_driver_name.name"/> </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-bottom: 20px !important;text-align: left;padding-left: 50px;">
                                    <span style="padding-right:10px">Date :</span>
<!--                                    <span> <t t-if="o.env.user" t-esc="DateTime.today().strftime('%Y-%m-%d') or ''"/> </span>-->
                                    <span> <t t-esc="datetime.datetime.now().strftime('%m/%d/%y')"/> </span>
                                </td>
                                <td style="padding-bottom: 20px !important;text-align: left;padding-left: 50px;">
                                    <span style="padding-right:10px">Date :</span>
                                    <span>
                                        <t t-if="o.truck_driver_signature" t-esc="o.truck_driver_sign_date and o.truck_driver_sign_date.strftime('%m/%d/%y') or ''"/>
                                    </span>
                                </td>
                            </tr>
                        </table>

                        <t t-set="total_qty" t-value="sum(o.move_line_ids_without_package.mapped('qty_done'))"/>
                        <t t-set="total_pallets" t-value="sum(o.move_line_ids_without_package.mapped('no_of_pallets'))"/>

                        <table class="display-table">
                            <thead>
                                <tr >
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td style="text-align: right;padding-right:5px;"> Quantity</td>
                                    <td> UOM </td>
                                    <td style="text-align: right;">Pallets</td>
                                    <td style="text-align: right;padding-right:10px !important;">Net Weight </td>
                                </tr>
                            </thead>
                        </table>

                        <table class="display-table" style="background-color: #b8b8b8;border-bottom:1px solid #000 !important;">
                                <thead>
                                    <tr>
                                        <td class="text_data"> Total </td>
                                        <td class="text_data"></td>
                                        <td class="text_data"></td>
                                        <td class="text_data"></td>
                                        <td class="text_data" style="text-align: right;padding-right:5px;">
                                            <t t-esc="'{:,d}'.format(total_qty and int(total_qty) or 0)"/>
                                        </td>
                                        <td class="text_data">
                                            <t t-esc="o.move_line_ids_without_package and o.move_line_ids_without_package[0].product_uom_id.name"/>
                                        </td>
                                        <td style="text-align: right;">
                                            <t t-esc="int(total_pallets)"/>
                                        </td>
                                        <td class="text_data" style="text-align: right;padding-right:10px !important;">
                                            <t t-set="main_weight" t-value="total_weight"/>
                                            <t t-esc="'{:,d}'.format(int(main_weight) or 0)"/>
                                        </td>
                                    </tr>
                                </thead>
                            </table>
                    </t>
                </div>

            </t>
        </template>

    </data>
</odoo>
