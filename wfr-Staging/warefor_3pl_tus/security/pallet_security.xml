<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_pallet_user" model="res.groups">
            <field name="name">Pallet Configurations</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_warefor_portal" model="res.groups">
            <field name="name">Warefor Portal Access</field>
        </record>
        <record id="customer_rule_purchase" model="ir.rule">
            <field name="name">Customer Can See Own Purchase Order</field>
            <field name="model_id" ref="model_purchase_order"/>
            <field name="groups" eval="[(4, ref('warefor_3pl_tus.group_warefor_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="customer_rule_sale" model="ir.rule">
            <field name="name">Customer Can See Own Sale Order</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('warefor_3pl_tus.group_warefor_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="customer_rule_sale_line" model="ir.rule">
            <field name="name">Customer Can See Own Sale Order Line</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('warefor_3pl_tus.group_warefor_portal'))]"/>
            <field name="domain_force">[('order_id.partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="account_invoice_rule_see_personal" model="ir.rule">
            <field name="name">Personal Invoices</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="groups" eval="[(4, ref('warefor_3pl_tus.group_warefor_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]
            </field>
        </record>
    </data>
</odoo>
