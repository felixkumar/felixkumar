<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
<record model="ir.ui.view" id="account_view_inherit"> 
    <field name="name">account.view.inherit</field>
    <field name="model">account.invoice</field>
    <field name="inherit_id" ref="account.invoice_form"/>
    <field name="arch" type="xml"> 
        <xpath expr="/form/sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
            <field name="barcode_scan"/>
   
        </xpath> 
    </field> 
 </record>
 
 
 <record model="ir.ui.view" id="invoice_supplier_form_inherit_l10n_lv"> 
    <field name="name">account.invoice.supplier.form.inherit.l10n.lv</field>
    <field name="model">account.invoice</field>
    <field name="inherit_id" ref="account.invoice_supplier_form"/>
    <field name="arch" type="xml"> 
        <xpath expr="/form/sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
            <field name="barcode_scan"/>
   
        </xpath> 
    </field> 
 </record>
</data>
</odoo>
