<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_last_so_po" model="ir.ui.view">
            <field name="name">res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='property_payment_term_id']" position="after">
                    <field name="pw_last_sale_id"/>
                	  <field name="pw_last_sale_date"/>
                	  <field name="remaining_days" widget="remaining_days"/>
                </xpath>
                <xpath expr="//field[@name='property_supplier_payment_term_id']" position="after">
                    <field name="pw_last_purchase_id"/>
                    <field name="pw_last_purchase_date"/>
                     <field name="remaining_pdays" widget="remaining_pdays"/>
                </xpath>
            </field>
        </record>
        <record id="view_partner_tree_add_last_so_po" model="ir.ui.view">
            <field name="name">res.partner.tree</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <field name="pw_last_sale_id"/>
                    <field name="pw_last_sale_date" widget="remaining_days"/>
                    <field name="remaining_days" widget="remaining_days"/>
                    <field name="pw_last_purchase_id"/>
                    <field name="pw_last_purchase_date" widget="remaining_days"/>
                    <field name="remaining_pdays" widget="remaining_pdays"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
